{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "altcha-org/altcha": "^2.1",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.2",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "^5.6.0",
        "knplabs/knp-paginator-bundle": "^6.11",
        "liip/imagine-bundle": "^2.17.2",
        "nelmio/security-bundle": "^3.9",
        "presta/sitemap-bundle": "^4.3.1",
        "sentry/sentry-symfony": "^5.13",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.5.1",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-chartjs": "^3.5.1",
        "symfony/ux-live-component": "^3.5.1",
        "symfony/ux-turbo": "^3.5.1",
        "symfony/ux-twig-component": "^3.5.1",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.29",
        "twig/intl-extra": "^3.30",
        "twig/twig": "^3.30"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --fix --ansi",
        "rector-dry": "vendor/bin/rector process --dry-run",
        "rector": "vendor/bin/rector process",
        "phpstan": "php -d memory_limit=256M vendor/bin/phpstan analyze",
        "test-unit": "vendor/bin/phpunit --testsuite=Unit --no-coverage",
        "schema-test": "php bin/console doctrine:schema:update --env=test --force",
        "test-integration": "vendor/bin/phpunit --testsuite=Integration --no-coverage",
        "test-controller": "vendor/bin/phpunit --testsuite=Controller --no-coverage",
        "check-data": [
            "php bin/console app:check:compounds",
            "php bin/console app:check:data"
        ],
        "ci": [
            "@check-cs",
            "@phpstan",
            "@test-unit",
            "@schema-test",
            "@test-integration",
            "@test-controller",
            "@check-data"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "amphp/http-client": ">=5.3.6",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.6",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpunit/phpunit": ">=13.3",
        "rector/rector": ">=2.6.7",
        "symfony/apache-pack": "^1.0.1",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "symplify/easy-coding-standard": "^13.3.2",
        "vich/uploader-bundle": "^3.0"
    }
}
