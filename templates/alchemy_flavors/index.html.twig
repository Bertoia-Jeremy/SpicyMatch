{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.catalog.flavors_page_title'|trans }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <twig:Catalog:Header
        tag="{{ 'ui.catalog.flavors_tag'|trans }}"
        title="{{ 'ui.catalog.flavors_title'|trans }}"
        intro="{{ 'ui.catalog.flavors_page_intro'|trans }}"
    />

    <twig:Catalog:Grid>
        {% for flavor in alchemyFlavors %}
            <twig:Catalog:Card
                title="{{ flavor.getLocalizedName(loc) }}"
                description="{{ flavor.getLocalizedDescription(loc) }}"
                href="{{ path('view_alchemy_flavors', {slug: flavor.getLocalizedSlug(loc)}) }}"
                cta="{{ 'ui.catalog.explore_flavor'|trans }}"
                icon="fa-solid fa-flask-vial"
                tone="turmeric"
            />
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-stone-400">{{ 'ui.catalog.no_flavor'|trans }}</p>
            </div>
        {% endfor %}
    </twig:Catalog:Grid>
</section>
{% endblock %}
