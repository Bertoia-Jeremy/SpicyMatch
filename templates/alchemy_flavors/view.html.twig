{% extends 'base.html.twig' %}

{% block title %}{{ alchemyFlavor.getLocalizedName(app.request.locale) }} — SpicyMatch{% endblock %}

{% block meta_description %}{{ alchemyFlavor.getLocalizedDescription(app.request.locale)|seo_summary|default('ui.meta.description'|trans) }}{% endblock %}

{% block structured_data %}{{ include('partials/_json_ld.html.twig', {subject: alchemyFlavor}) }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <twig:Catalog:Hero
        backLabel="{{ 'ui.catalog.back_to_flavors'|trans }}"
        backHref="{{ path('index_alchemy_flavors') }}"
        badge="{{ 'ui.catalog.flavor_badge'|trans }}"
        icon="fa-solid fa-flask-vial"
        tone="turmeric"
        title="{{ alchemyFlavor.getLocalizedName(loc) }}"
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-8">
            <twig:Catalog:Section title="{{ 'ui.catalog.taste_profile'|trans }}" icon="fa-solid fa-circle-info" tone="turmeric">
                {{ alchemyFlavor.getLocalizedDescription(loc)|default('ui.catalog.no_profile_detailed'|trans)|nl2br }}
            </twig:Catalog:Section>

            {% if alchemyFlavor.getLocalizedCooking(loc) %}
                <twig:Catalog:Section title="{{ 'ui.catalog.culinary_pairings'|trans }}" icon="fa-solid fa-mortar-pestle" tone="turmeric">
                    {{ alchemyFlavor.getLocalizedCooking(loc)|nl2br }}
                </twig:Catalog:Section>
            {% endif %}

            {% if alchemyFlavor.getLocalizedInformations(loc) %}
                <twig:Catalog:Section title="{{ 'ui.catalog.scientific_note'|trans }}" icon="fa-solid fa-flask" tone="turmeric">
                    {{ alchemyFlavor.getLocalizedInformations(loc)|nl2br }}
                </twig:Catalog:Section>
            {% endif %}
        </div>

        <aside class="space-y-8">
            <section>
                <h2 class="text-xl font-bold text-stone-900 mb-6 flex items-center gap-2">
                    <i class="fa-solid fa-atom text-saffron-600" aria-hidden="true"></i> {{ 'ui.catalog.associated_compounds'|trans }}
                </h2>

                {% if alchemyFlavor.aromaticsCompounds is not empty %}
                    <div class="grid grid-cols-1 gap-3">
                        {% for compound in alchemyFlavor.aromaticsCompounds %}
                            <a href="{{ path('view_aromatic_compound', {slug: compound.getLocalizedSlug(loc)}) }}"
                               class="flex items-center justify-between p-4 bg-white border border-stone-200 rounded-xl hover:border-saffron-400 hover:shadow-md transition-all group">
                                <span class="font-semibold text-stone-700 group-hover:text-saffron-700">{{ compound.getLocalizedName(loc) }}</span>
                                <i class="fa-solid fa-chevron-right text-stone-300 text-xs group-hover:text-saffron-500 transition-colors" aria-hidden="true"></i>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-stone-400 italic">{{ 'ui.catalog.no_linked_compound'|trans }}</p>
                {% endif %}
            </section>
        </aside>
    </div>
</div>
{% endblock %}
