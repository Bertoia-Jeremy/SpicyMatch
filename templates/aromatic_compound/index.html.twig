{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.catalog.compounds_page_title'|trans }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <twig:Catalog:Header
        tag="{{ 'ui.catalog.compounds_tag'|trans }}"
        title="{{ 'ui.catalog.compounds_title'|trans }}"
        intro="{{ 'ui.catalog.compounds_intro'|trans }}"
    />

    <twig:Catalog:Grid>
        {% for compound in aromaticCompounds %}
            <twig:Catalog:Card
                title="{{ compound.getLocalizedName(loc) }}"
                description="{{ compound.getLocalizedDescription(loc) }}"
                href="{{ path('view_aromatic_compound', {slug: compound.getLocalizedSlug(loc)}) }}"
                cta="{{ 'ui.catalog.learn_more'|trans }}"
                icon="fa-solid fa-atom"
                tone="saffron"
            />
            {% if loop.last and not loop.first %}
                {% include 'partials/_ads_grid_row.html.twig' %}
            {% endif %}
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-stone-400">{{ 'ui.catalog.no_compound'|trans }}</p>
            </div>
        {% endfor %}
    </twig:Catalog:Grid>
</section>
{% endblock %}
