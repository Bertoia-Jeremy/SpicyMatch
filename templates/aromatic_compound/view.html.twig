{% extends 'base.html.twig' %}

{% block title %}{{ aromaticCompound.getLocalizedName(app.request.locale) }} — SpicyMatch{% endblock %}

{% block meta_description %}{{ aromaticCompound.getLocalizedDescription(app.request.locale)|seo_summary|default('ui.meta.description'|trans) }}{% endblock %}

{% block structured_data %}{{ include('partials/_json_ld.html.twig', {subject: aromaticCompound}) }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
{{ include('partials/_content_read.html.twig', {kind: 'compound', id: aromaticCompound.id}) }}
{% include 'components/_spice_modal.html.twig' %}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <twig:Catalog:Hero
        backLabel="{{ 'ui.catalog.back_to_compounds'|trans }}"
        backHref="{{ path('index_aromatic_compound') }}"
        badge="{{ 'ui.catalog.compound_badge'|trans }}"
        icon="fa-solid fa-atom"
        title="{{ aromaticCompound.getLocalizedName(loc) }}"
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mb-16">
        <div class="lg:col-span-2 space-y-8">
            <twig:Catalog:Section title="{{ 'ui.catalog.description'|trans }}" icon="fa-solid fa-circle-info">
                {{ aromaticCompound.getLocalizedDescription(loc)|default('ui.catalog.no_description_detailed'|trans)|nl2br }}
            </twig:Catalog:Section>

            {% if aromaticCompound.getLocalizedCooking(loc) %}
                <twig:Catalog:Section title="{{ 'ui.catalog.in_kitchen'|trans }}" icon="fa-solid fa-mortar-pestle">
                    {{ aromaticCompound.getLocalizedCooking(loc)|nl2br }}
                </twig:Catalog:Section>
            {% endif %}
        </div>

        <aside class="space-y-8">
            {% if aromaticCompound.getLocalizedInformations(loc) %}
                <twig:Catalog:Section title="{{ 'ui.catalog.scientific_note'|trans }}" icon="fa-solid fa-flask" small>
                    {{ aromaticCompound.getLocalizedInformations(loc)|nl2br }}
                </twig:Catalog:Section>
            {% endif %}
        </aside>
    </div>

    <twig:Catalog:LinkedSpices :spices="aromaticCompound.spices|merge(aromaticCompound.secondarySpices)" title="{{ 'ui.catalog.linked_spices'|trans }}" />
</div>
{% endblock %}
