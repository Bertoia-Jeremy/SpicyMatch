{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.catalog.groups_page_title'|trans }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <twig:Catalog:Header
        tag="{{ 'ui.catalog.groups_tag'|trans }}"
        title="{{ 'ui.catalog.groups_title'|trans }}"
        intro="{{ 'ui.catalog.groups_intro'|trans }}"
    />

    <twig:Catalog:Grid>
        {% for group in aromaticGroups %}
            <twig:Catalog:Card
                title="{{ group.getLocalizedName(loc) }}"
                description="{{ group.getLocalizedDescription(loc) }}"
                href="{{ path('view_aromatic_groups', {slug: group.getLocalizedSlug(loc)}) }}"
                cta="{{ 'ui.catalog.view_spices'|trans }}"
                icon="fa-solid fa-layer-group"
                tone="saffron"
                color="{{ group.color }}"
            />
            {% if loop.last and not loop.first %}
                {% include 'partials/_ads_grid_row.html.twig' %}
            {% endif %}
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-stone-400">{{ 'ui.catalog.no_group'|trans }}</p>
            </div>
        {% endfor %}
    </twig:Catalog:Grid>
</section>
{% endblock %}
