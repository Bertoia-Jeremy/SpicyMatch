{% extends '_error_layout.html.twig' %}

{% block title %}{{ 'ui.error.404.title'|trans }}{% endblock %}

{% block body %}
    {% set homeUrl = path('home', {'_locale': app.request.locale}) %}
    {% set countdownParts = 'ui.error.404.countdown'|trans|split('%count%') %}

    {% set academyUrl = path('education_index', {'_locale': app.request.locale}) %}

    <section x-data="errorCountdown(10, '{{ homeUrl }}')"
             class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <div class="card-warm p-10">
            <div class="w-16 h-16 rounded-full bg-spice-surface border border-spice-border flex items-center justify-center mx-auto mb-6 motion-safe:animate-bounce-slow">
                <i class="fa-solid fa-pepper-hot text-saffron-700 text-2xl" aria-hidden="true"></i>
            </div>
            <p class="font-display text-6xl font-bold text-saffron-700 leading-none mb-4">404</p>
            <h1 class="text-3xl font-bold text-stone-900 mb-3">{{ 'ui.error.404.title'|trans }}</h1>
            <p class="text-stone-500 mb-8">{{ 'ui.error.404.description'|trans }}</p>

            <div class="flex flex-wrap gap-3 justify-center">
                <twig:Button
                    label="{{ 'ui.error.404.back'|trans }}"
                    href="{{ homeUrl }}"
                    variant="primary"
                    icon="fa-solid fa-house"
                    data-turbo="false"
                />
                <twig:Button
                    label="{{ 'ui.error.404.explore'|trans }}"
                    href="{{ academyUrl }}"
                    variant="secondary"
                    icon="fa-solid fa-graduation-cap"
                    data-turbo="false"
                />
            </div>

            <p class="mt-6 text-sm text-stone-500" aria-live="polite">
                {{- countdownParts[0] -}}
                <span x-text="remaining" class="font-semibold text-saffron-700">10</span>
                {{- countdownParts[1]|default('') -}}
            </p>
        </div>
    </section>
{% endblock %}
