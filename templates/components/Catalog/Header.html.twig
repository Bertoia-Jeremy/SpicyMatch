{% props tag, title, intro = null %}
<div class="text-center mb-12">
    <span class="tag-primary mb-4 inline-block">{{ tag }}</span>
    <h1 class="text-4xl font-bold text-stone-900 mb-3">{{ title }}</h1>
    {% if intro %}
        <p class="text-stone-500 text-lg max-w-2xl mx-auto">{{ intro }}</p>
    {% endif %}
</div>
