{% set quitUrl = path('education_briefing', { mode: 'hangman', difficulty: this.difficulty }) %}

{% set heat = min(this.errorsCount, this.maxErrors) %}
{% set rest = this.maxErrors - heat %}
{% set r = this.maxErrors > 0 ? (heat / this.maxErrors) : 0 %}
{% set tier = r <= (1/6) ? 1 : (r <= 0.5 ? 2 : 3) %}

{% set scaledHeat = r * 6 %}
{% set mcol = r >= 0.833 ? '#991B1B' : (r >= 0.5 ? '#C2410C' : '#D97706') %}
{% set dark = r >= 0.833 ? '#3d0f0f' : (r >= 0.5 ? '#2a1608' : '#15100c') %}
{% set found = this.maskedChars|length > 0 ? (1 - (this.maskedChars|filter(c => c == '_')|length / this.maskedChars|length)) : 0 %}
{% set glow = r >= 0.833
    ? 'rgba(153,27,27,' ~ (0.30 + r * 0.45)|number_format(2) ~ ')'
    : 'rgba(217,119,6,' ~ (0.10 + found * 0.34 + r * 0.30)|number_format(2) ~ ')' %}
{% set dish = ['#E8D9BC', '#DFC391', '#CFA463', '#B4772F', '#8A501B', '#4A2A11', '#1F1712'][min(scaledHeat|round, 6)] %}
{% set wave = max(0, (scaledHeat - 1) / 5)|number_format(2) %}
{% set merc = 10 + r * 70 %}
{% set my = 172 - merc %}

{% set lettersLeft = this.maskedChars|filter(c => c == '_')|length %}

<div {{ attributes.defaults({class: 'cc'}) }} x-data="{ rulesOpen: false }">
  <div aria-live="polite" class="sr-only">
    {%- if this.isFinished %}{{ 'ui.game.a11y_finished'|trans }}
    {%- elseif this.showFeedback %}
      {%- if this.wordSolved %}{{ 'ui.game.found'|trans }} {{ this.revealedWord }}
      {%- else %}{{ 'ui.game.a11y_incorrect'|trans({'%name%': this.revealedWord}) }}
      {%- endif %}
    {%- elseif this.maskedWord %}
      {{- 'ui.game.a11y_question'|trans({'%num%': this.questionNumber, '%total%': this.totalQuestions}) }}
      {{ 'ui.game.a11y_word_state'|trans({'%word%': this.maskedChars|join(' '), '%errors%': this.errorsCount, '%max%': this.maxErrors}) }}
    {%- endif %}
  </div>

  <div class="cc-bar">
    <button type="button" class="cc-icb" x-data="confirmQuit('{{ quitUrl }}')" @click="quit()" aria-label="{{ 'ui.game.quit'|trans }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5l-7 7 7 7"/>
      </svg>
    </button>
    <div class="cc-bar-mid">
      <p class="cc-t">{{ 'enum.game_mode.hangman.label'|trans }}</p>
      <p class="cc-s cc-mono">{{ this.questionNumber }}/{{ this.totalQuestions }} · {{ this.correctCount }}<i class="fa-solid fa-check text-[8px] mx-0.5" aria-hidden="true"></i>{{ this.incorrectCount }}<i class="fa-solid fa-xmark text-[8px] mx-0.5" aria-hidden="true"></i></p>
    </div>
    <button type="button" class="cc-rules" @click="rulesOpen = !rulesOpen" :aria-expanded="rulesOpen.toString()" aria-label="{{ 'ui.edu.rules'|trans }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/><path d="M12 16v-4"/><path d="M12 8.5v.01"/>
      </svg>
    </button>
  </div>

  <div class="cc-rules-panel" x-show="rulesOpen" x-cloak x-transition>
    <ul>
      {% for rule in this.rules %}
        <li>{{ rule }}</li>
      {% endfor %}
    </ul>
  </div>

  <div class="cc-steps">
    {% for i in 1..this.totalQuestions %}
      <span class="{{ i < this.questionNumber ? 'cc-on' : '' }}{{ i == this.questionNumber ? ' cc-cur' : '' }}"></span>
    {% endfor %}
  </div>

  <div class="cc-split">
    <div class="cc-pane-l">
      <div class="cc-stage">
        <div class="cc-heat">
          <span class="cc-lbl{{ tier == 2 ? ' cc-t2' : (tier == 3 ? ' cc-t3' : '') }}">
            {%- if rest > 1 %}{{ 'ui.game.hangman_attempts_left'|trans({'%count%': rest}) }}
            {%- elseif rest == 1 %}{{ 'ui.game.hangman_last_attempt'|trans }}
            {%- else %}{{ 'ui.game.hangman_overcooked'|trans }}
            {%- endif %}
          </span>
          <span class="cc-pips{{ tier == 2 ? ' cc-t2' : (tier == 3 ? ' cc-t3' : '') }}">
            {% for i in 0..(this.maxErrors - 1) %}
              <i class="{{ i >= rest ? 'cc-lost' : '' }}"></i>
            {% endfor %}
          </span>
        </div>
        <div class="cc-oven">
          <div class="cc-smoke{{ heat >= 2 ? ' cc-show' : '' }}" style="opacity:{{ heat >= 2 ? min(1, 0.35 + (heat - 2) * 0.22) : 0 }}">
            <i style="width:12px;height:12px"></i><i style="width:20px;height:20px"></i><i style="width:15px;height:15px"></i>
          </div>
          <svg viewBox="0 0 200 210" fill="none" aria-hidden="true">
            <rect x="26" y="30" width="148" height="150" rx="7" fill="#FDFBF7" stroke="#3a2e25" stroke-width="2.5"/>
            <line x1="26" y1="64" x2="174" y2="64" stroke="#3a2e25" stroke-width="2.5"/>
            <circle cx="52" cy="47" r="5.5" fill="none" stroke="#3a2e25" stroke-width="2"/>
            <circle cx="148" cy="47" r="9" fill="none" stroke="#3a2e25" stroke-width="2"/>
            <line x1="148" y1="47" x2="148" y2="41" stroke="#3a2e25" stroke-width="2"/>
            <rect x="70" y="41" width="60" height="6" rx="3" fill="none" stroke="#3a2e25" stroke-width="1.2" opacity=".4"/>
            <rect x="70" y="41" width="{{ 6 + scaledHeat * 9 }}" height="6" rx="3" fill="{{ mcol }}" opacity=".9"/>
            <rect x="40" y="78" width="120" height="88" rx="4" fill="{{ dark }}" stroke="#3a2e25" stroke-width="2.5"/>
            <rect x="48" y="86" width="104" height="72" rx="2" fill="{{ glow }}"/>
            <g opacity="{{ wave }}" stroke="#FDFBF7" stroke-width="1.4" stroke-linecap="round" fill="none">
              <path d="M66 114c5-5 10 5 15 0s10 5 15 0"/><path d="M104 104c5-5 10 5 15 0"/><path d="M62 96c5-5 10 5 15 0"/>
            </g>
            <line x1="58" y1="147" x2="142" y2="147" stroke="#FDFBF7" stroke-width="1.4" opacity=".28"/>
            <ellipse cx="100" cy="140" rx="{{ 30 - scaledHeat }}" ry="{{ 9.5 - scaledHeat * 0.35 }}" fill="{{ dish }}"/>
            <ellipse cx="{{ 92 - scaledHeat * 0.4 }}" cy="137.5" rx="{{ 8 - scaledHeat * 0.5 }}" ry="{{ 2.4 - scaledHeat * 0.1 }}" fill="#FDFBF7" opacity="{{ max(0, 0.34 - scaledHeat * 0.055)|number_format(2) }}"/>
            <line x1="46" y1="180" x2="46" y2="196" stroke="#3a2e25" stroke-width="2.5"/>
            <line x1="154" y1="180" x2="154" y2="196" stroke="#3a2e25" stroke-width="2.5"/>
            <rect x="6" y="82" width="11" height="90" rx="5.5" fill="#FDFBF7" stroke="#3a2e25" stroke-width="2"/>
            <rect x="9" y="{{ my|number_format(1) }}" width="5" height="{{ merc|number_format(1) }}" rx="2.5" fill="{{ mcol }}"/>
            <g stroke="#3a2e25" stroke-width="1.4" opacity=".45"><line x1="19" y1="96" x2="24" y2="96"/><line x1="19" y1="127" x2="24" y2="127"/><line x1="19" y1="158" x2="24" y2="158"/></g>
            <circle cx="11.5" cy="180" r="9" fill="{{ mcol }}"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="cc-pane-r">
      <div>
        <div class="cc-word" style="--n:{{ this.maskedChars|length }}">
          {% for char in this.maskedChars %}
            {% if char == ' ' %}
              <b style="max-width:16px;height:16px;border:none;background:none" aria-hidden="true">&nbsp;</b>
            {% elseif char == '_' %}
              <b class="cc-hid">_</b>
            {% else %}
              <b>{{ char }}</b>
            {% endif %}
          {% endfor %}
        </div>
        <p class="cc-wmeta cc-mono">
          {%- if this.showFeedback %}
            {{ this.wordSolved ? 'ui.game.found'|trans : 'ui.game.lost'|trans }}
          {%- elseif lettersLeft > 1 %}{{ 'ui.game.hangman_letters_left'|trans({'%count%': lettersLeft}) }}
          {%- elseif lettersLeft == 1 %}{{ 'ui.game.hangman_letter_left'|trans }}
          {%- else %}{{ 'ui.game.hangman_served'|trans }}
          {%- endif %}
        </p>
      </div>

      {% if this.hint %}
        <div class="cc-hint" x-data="{open:false}" :class="open ? 'cc-open' : ''">
          <button type="button" @click="open = !open" :aria-expanded="open.toString()">
            <span class="cc-bulb">
              <svg viewBox="0 0 24 24" fill="none" stroke="#A85A05" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9V18h7v-4.1A6 6 0 0 0 12 3z"/>
              </svg>
            </span>
            <span class="cc-ht">{{ 'ui.game.hangman_hint_label'|trans }}</span>
            <span class="cc-cost">{{ 'ui.game.hangman_hint_cta'|trans }}</span>
          </button>
          <div class="cc-body">{{ this.hint }}</div>
        </div>
      {% endif %}

      <div class="cc-kb" x-data="hangmanKeyboard()" data-word-num="{{ this.questionNumber }}">
        {% for row in ['AZERTYUIOP', 'QSDFGHJKLM', 'WXCVBN'] %}
          <div class="cc-krow">
            {% for letter in row|split('') %}
              {% set isCorrect = letter in this.correctGuesses %}
              {% set isGuessed = letter in this.guessedLetters %}
              <button type="button"
                      class="cc-k{{ isCorrect ? ' cc-good' : (isGuessed ? ' cc-bad' : '') }}"
                      data-letter="{{ letter }}"
                      {% if not this.showFeedback %}
                        data-action="live#action"
                        data-live-action-param="guessLetter"
                        data-live-letter-param="{{ letter }}"
                        @click="guess('{{ letter }}')"
                      {% endif %}
                      {{ (isGuessed or this.showFeedback) ? 'disabled' : '' }}
                      :class="isPending('{{ letter }}') ? 'opacity-40 pointer-events-none' : ''">
                {{ letter }}
              </button>
            {% endfor %}
          </div>
        {% endfor %}
        <div class="cc-kbnote cc-mono">{{ 'ui.game.keyboard_note'|trans }}</div>
      </div>

      {% if this.showFeedback %}
        <twig:Button
            label="{{ this.questionNumber >= this.totalQuestions ? 'ui.game.finish'|trans : 'ui.game.next_word'|trans }}"
            variant="{{ this.wordSolved ? 'primary' : 'secondary' }}"
            icon="{{ this.questionNumber >= this.totalQuestions ? 'fa-solid fa-flag-checkered' : 'fa-solid fa-arrow-right' }}"
            data-action="live#action"
            data-live-action-param="nextWord"
            extra="w-full mt-3" />
      {% endif %}
    </div>
  </div>
</div>
