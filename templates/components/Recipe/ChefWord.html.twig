{% props duo = null %}
{% if duo %}
    {% set tabs = {effect: duo.effect, science: duo.science, example: duo.example}|filter(v => v is not empty) %}
    {% set first = tabs|keys|first %}
    <aside class="chef-word recipe-chef" aria-label="{{ 'ui.recipe.chef_word'|trans }}" x-data="{ chefTab: '{{ first }}' }" x-init="$watch('openSpiceId', () => chefTab = '{{ first }}')">
        <div class="recipe-mono text-saffron-800">{{ 'ui.recipe.chef_word'|trans }}</div>
        <div class="chef-word-title recipe-chef-title">{{ duo.title }}</div>
        {% if tabs is not empty %}
            <div class="recipe-chef-tabs" role="tablist">
                {% for key in tabs|keys %}
                    <button type="button" role="tab" class="recipe-chip"
                            x-on:click="chefTab = '{{ key }}'"
                            x-bind:class="chefTab === '{{ key }}' && 'is-active'"
                            x-bind:aria-selected="chefTab === '{{ key }}'"
                            {% if loop.first %}aria-selected="true"{% endif %}>{{ ('ui.recipe.chef_' ~ key)|trans }}</button>
                {% endfor %}
            </div>
            <div class="chef-word-list recipe-chef-body">
                {% for key, text in tabs %}
                    <p role="tabpanel" x-show="chefTab === '{{ key }}'" {% if not loop.first %}x-cloak{% endif %}>{{ text }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </aside>
{% else %}
    <p class="recipe-chef-empty">{{ 'ui.recipe.no_chef_word'|trans }}</p>
{% endif %}
