{% macro footer_link(href, label) %}
    <li><a href="{{ href }}" class="footer-link">{{ label }}</a></li>
{% endmacro %}
{% import _self as f %}
<footer class="site-footer" role="contentinfo">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="site-footer-grid">

            <div class="site-footer-brand">
                <a href="{{ path('home') }}" class="site-footer-home">
                    <svg class="site-footer-logo" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="200" cy="200" r="150" fill="none" stroke="#C46E1F" stroke-width="2.4" stroke-dasharray="2 9" stroke-linecap="round" opacity="0.85"/>
                        <circle cx="200" cy="200" r="150" fill="none" stroke="#C46E1F" stroke-width="6"
                                stroke-dasharray="518.36 9999" stroke-linecap="round"
                                transform="rotate(-90 200 200)"/>
                        <g stroke="#0A0907" stroke-width="4" fill="none">
                            <line x1="200" y1="150" x2="243" y2="175"/>
                            <line x1="243" y1="175" x2="243" y2="225"/>
                            <line x1="243" y1="225" x2="200" y2="250"/>
                            <line x1="200" y1="250" x2="157" y2="225"/>
                            <line x1="157" y1="225" x2="157" y2="175"/>
                            <line x1="157" y1="175" x2="200" y2="150"/>
                        </g>
                        <g stroke="#C46E1F" stroke-width="6" fill="none" stroke-linecap="round">
                            <path d="M 200 150 Q 210 100 200 50"/>
                            <path d="M 243 225 Q 295 245 330 275"/>
                            <path d="M 157 225 Q 105 245 70 275"/>
                        </g>
                        <g fill="#C46E1F">
                            <circle cx="200" cy="50" r="11"/>
                            <circle cx="330" cy="275" r="11"/>
                            <circle cx="70" cy="275" r="11"/>
                        </g>
                        <g fill="#0A0907">
                            <circle cx="243" cy="175" r="5"/>
                            <circle cx="200" cy="250" r="5"/>
                            <circle cx="157" cy="175" r="5"/>
                            <circle cx="200" cy="150" r="6"/>
                            <circle cx="243" cy="225" r="6"/>
                            <circle cx="157" cy="225" r="6"/>
                        </g>
                    </svg>
                    <span class="font-display site-footer-name">Spicy <em>Match</em></span>
                </a>
                <p class="site-footer-tagline">{{ 'ui.footer.tagline'|trans }}</p>
                <ul class="site-footer-trust">
                    <li><i class="fa-solid fa-eye-slash" aria-hidden="true"></i>{{ 'ui.footer.trust.tracking'|trans }}</li>
                    <li><i class="fa-solid fa-book-open" aria-hidden="true"></i>{{ 'ui.footer.trust.free'|trans }}</li>
                    <li><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i>{{ 'ui.footer.trust.independent'|trans }}</li>
                </ul>
                <a href="{{ path('premium') }}" class="site-footer-support">
                    {{ 'ui.footer.support_cta'|trans }} <span aria-hidden="true">→</span>
                </a>
            </div>

            <nav class="site-footer-col" aria-labelledby="footer-explore">
                <h2 id="footer-explore" class="site-footer-heading">{{ 'ui.footer.explore'|trans }}</h2>
                <ul>
                    {{ f.footer_link(path('index_spices'), 'ui.footer.spices'|trans) }}
                    {{ f.footer_link(path('index_aromatic_groups'), 'ui.footer.aromatic_groups'|trans) }}
                    {{ f.footer_link(path('index_alchemy_flavors'), 'ui.footer.flavors'|trans) }}
                    {{ f.footer_link(path('index_aromatic_compound'), 'ui.footer.aromatic_compounds'|trans) }}
                    {{ f.footer_link(path('index_spicy_type'), 'ui.footer.spicy_types'|trans) }}
                    {{ f.footer_link(path('index_preparation_methods'), 'ui.footer.preparation_methods'|trans) }}
                </ul>
            </nav>

            <nav class="site-footer-col" aria-labelledby="footer-cook">
                <h2 id="footer-cook" class="site-footer-heading">{{ 'ui.footer.cook'|trans }}</h2>
                <ul>
                    {{ f.footer_link(path('index_spicy_match'), 'ui.footer.lab'|trans) }}
                    {% if is_granted('ROLE_USER') %}
                        {{ f.footer_link(path('index_spicy_match_history'), 'ui.profile.menu.history'|trans) }}
                    {% endif %}
                    {% if gamification_on() %}
                        {{ f.footer_link(path('education_index'), 'ui.common.academy'|trans) }}
                    {% endif %}
                    {{ f.footer_link(path('help_index'), 'ui.navbar.help'|trans) }}
                    {{ f.footer_link(path('new_contact'), 'ui.common.contact'|trans) }}
                </ul>
            </nav>

            <div class="site-footer-col site-footer-account">
                <h2 class="site-footer-heading">{{ 'ui.footer.account'|trans }}</h2>
                {% if is_granted('ROLE_USER') %}
                    <ul>
                        {{ f.footer_link(path('profile_user', {tab: 'dashboard'}), 'ui.profile.menu.dashboard'|trans) }}
                        {{ f.footer_link(path('profile_user', {tab: 'grimoire'}), 'ui.profile.menu.grimoire'|trans) }}
                        {{ f.footer_link(path('profile_user', {tab: 'lab'}), 'ui.profile.menu.lab'|trans) }}
                        {{ f.footer_link(logout_path(), 'ui.common.logout'|trans) }}
                    </ul>
                {% else %}
                    <p class="site-footer-join">{{ 'ui.footer.join_text'|trans }}</p>
                    <div class="site-footer-join-actions">
                        <twig:Button
                            label="{{ 'ui.navbar.create_account'|trans }}"
                            href="{{ path('index_register') }}"
                            variant="primary"
                            icon="fa-solid fa-arrow-right"
                            iconPos="right"
                        />
                        <a href="{{ path('app_login') }}" class="footer-link site-footer-login">{{ 'ui.footer.login'|trans }}</a>
                    </div>
                {% endif %}
            </div>

        </div>

        <div class="site-footer-bottom">
            <p class="site-footer-copy">
                &copy; {{ "now"|date("Y") }} SpicyMatch · <em class="font-display">{{ 'ui.footer.copyright_tagline'|trans }}</em>
            </p>
            <nav aria-label="{{ 'ui.footer.legal_nav'|trans }}">
                <ul class="site-footer-legal">
                    {{ f.footer_link(path('legal_notice'), 'ui.footer.legal'|trans) }}
                    {{ f.footer_link(path('privacy_policy'), 'ui.footer.privacy'|trans) }}
                    {{ f.footer_link(path('gdpr_request'), 'ui.footer.my_data'|trans) }}
                    {{ f.footer_link(path('accessibility_declaration'), 'ui.footer.accessibility'|trans) }}
                </ul>
            </nav>
        </div>

    </div>

    <div x-data="scrollTop" class="scroll-top-anchor fixed bottom-8 right-8 z-40">
        <button x-show="visible" x-cloak
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 translate-y-4 scale-90"
                x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                x-transition:leave="transition ease-in duration-200"
                x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                x-transition:leave-end="opacity-0 translate-y-4 scale-90"
                @click="scrollUp"
                aria-label="{{ 'ui.footer.scroll_top'|trans }}"
                class="site-footer-top group">
            <i class="fa-solid fa-arrow-up text-sm transition-transform group-hover:-translate-y-0.5" aria-hidden="true"></i>
        </button>
    </div>

</footer>
