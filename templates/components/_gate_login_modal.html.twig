{% set registrationForm = embedded_registration_form() %}
<div x-data="gateLoginModal"
     x-show="open"
     x-cloak
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     @gate-login.window="onGate($event)"
     @keydown.escape.window="close()"
     @keydown.tab.window="handleTab($event)"
     class="fixed inset-0 z-60 flex items-end sm:items-center justify-center p-4 sm:p-8"
     role="dialog" aria-modal="true" aria-labelledby="gate-login-title">

    <div class="absolute inset-0 bg-stone-900/60 backdrop-blur-sm" @click="close()"></div>

    <div class="relative z-10 w-full max-w-md max-h-[90vh] flex flex-col bg-cream rounded-2xl shadow-2xl border border-saffron-200/60 overflow-hidden">
        <twig:Button
            label="{{ 'common.close'|trans }}"
            iconOnly
            icon="fa-solid fa-xmark"
            variant="ghost"
            x-on:click="close()"
            extra="absolute top-4 right-4 z-10"
        />

        <div class="px-7 pt-8 pb-7 overflow-y-auto">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-saffron-100 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-saffron-200">
                    <i class="fa-solid fa-pepper-hot text-3xl text-saffron-600" aria-hidden="true"></i>
                </div>
                <h2 id="gate-login-title" class="text-xl font-bold text-stone-800">
                    <span x-show="isLoginTab()">{{ 'ui.auth.login_title'|trans }}</span>
                    <span x-show="isRegisterTab()">{{ 'ui.register.title'|trans }}</span>
                </h2>
            </div>

            <div class="flex rounded-full bg-stone-100 p-1 mb-6" role="tablist">
                <button type="button" role="tab" @click="showLogin()"
                        x-bind:aria-selected="isLoginTab() ? 'true' : 'false'"
                        x-bind:class="isLoginTab() ? 'bg-white shadow-sm text-stone-800' : 'text-stone-500'"
                        class="flex-1 py-2 rounded-full text-sm font-medium transition-colors">
                    {{ 'ui.auth.login_title'|trans }}
                </button>
                <button type="button" role="tab" @click="showRegister()"
                        x-bind:aria-selected="isRegisterTab() ? 'true' : 'false'"
                        x-bind:class="isRegisterTab() ? 'bg-white shadow-sm text-stone-800' : 'text-stone-500'"
                        class="flex-1 py-2 rounded-full text-sm font-medium transition-colors">
                    {{ 'ui.register.title'|trans }}
                </button>
            </div>

            <form x-show="isLoginTab()" method="post" action="{{ path('app_login') }}" class="space-y-4">
                <div>
                    <label for="gate-username" class="block text-sm font-medium text-stone-700 mb-1">{{ 'ui.auth.username'|trans }}</label>
                    <input type="text" id="gate-username" name="username" autocomplete="username"
                           class="w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-saffron-600/30 focus:border-saffron-500 bg-white text-stone-800"
                           required>
                </div>
                <div>
                    <label for="gate-password" class="block text-sm font-medium text-stone-700 mb-1">{{ 'ui.auth.password'|trans }}</label>
                    <input type="password" id="gate-password" name="password" autocomplete="current-password"
                           class="w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-saffron-600/30 focus:border-saffron-500 bg-white text-stone-800"
                           required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <input type="hidden" name="_target_path" x-bind:value="targetUrl">

                <twig:Button
                    label="{{ 'ui.auth.login_cta'|trans }}"
                    type="submit"
                    variant="primary"
                    icon="fa-solid fa-right-to-bracket text-xs"
                    extra="w-full justify-center"
                />
            </form>

            <div x-show="isRegisterTab()">
                {{ form_start(registrationForm, {'action': path('index_register'), 'attr': {'id': 'gate-register-form', 'class': 'space-y-4'}}) }}
                <div>
                    {{ form_label(registrationForm.username, 'ui.register.username'|trans, {'label_attr': {'class': 'block text-sm font-medium text-stone-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.username, {'attr': {'autocomplete': 'username', 'class': 'w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-saffron-600/30 focus:border-saffron-500 bg-white text-stone-800'}}) }}
                </div>

                <div>
                    {{ form_label(registrationForm.mail, 'ui.register.mail'|trans, {'label_attr': {'class': 'block text-sm font-medium text-stone-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.mail, {'attr': {'autocomplete': 'email', 'class': 'w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-saffron-600/30 focus:border-saffron-500 bg-white text-stone-800'}}) }}
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword, 'ui.register.password'|trans, {'label_attr': {'class': 'block text-sm font-medium text-stone-700 mb-1'}}) }}
                    <div class="relative" x-data="passwordVisibility">
                        {{ form_widget(registrationForm.plainPassword, {'attr': {
                            'autocomplete': 'new-password',
                            ':type': 'inputType()',
                            'class': 'w-full px-4 py-2.5 pr-24 border border-stone-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-saffron-600/30 focus:border-saffron-500 bg-white text-stone-800'
                        }}) }}
                        <button type="button" @click="show = !show"
                                class="absolute inset-y-0 right-0 px-3 flex items-center text-sm text-stone-600 hover:text-stone-700">
                            <span x-text="label()">{{ 'password.show'|trans({}, 'js') }}</span>
                        </button>
                    </div>
                </div>

                <div>
                    {% do registrationForm.altcha.setRendered() %}
                    {% include 'components/_altcha.html.twig' with {name: field_name(registrationForm.altcha)} only %}
                </div>

                <input type="hidden" name="_target_path" x-bind:value="targetUrl">

                <div>
                    <twig:Button
                        label="{{ 'ui.register.submit'|trans }}"
                        variant="primary"
                        type="submit"
                        name="{{ registrationForm.Valider.vars.full_name }}"
                        extra="w-full justify-center"
                    />
                </div>
                <div class="hidden">{{ form_widget(registrationForm.Valider) }}</div>
                {{ form_end(registrationForm) }}
            </div>

            <div class="mt-6 pt-5 border-t border-stone-200">
                <h3 class="text-sm font-semibold text-stone-700 mb-3">{{ 'ui.edu.gate.why_title'|trans }}</h3>
                <ul class="space-y-2.5 text-sm text-stone-600">
                    <li class="flex gap-2.5">
                        <i class="fa-solid fa-shield-halved text-saffron-600 mt-0.5" aria-hidden="true"></i>
                        <span>{{ 'ui.edu.gate.why_fair'|trans }}</span>
                    </li>
                    <li class="flex gap-2.5">
                        <i class="fa-solid fa-chart-line text-saffron-600 mt-0.5" aria-hidden="true"></i>
                        <span>{{ 'ui.edu.gate.why_progress'|trans }}</span>
                    </li>
                    <li class="flex gap-2.5">
                        <i class="fa-solid fa-user-gear text-saffron-600 mt-0.5" aria-hidden="true"></i>
                        <span>{{ 'ui.edu.gate.why_space'|trans }}</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
