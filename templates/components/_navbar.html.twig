{% macro herbierLogo(sizeClass) %}
    <svg class="{{ sizeClass|default('size-10') }}" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="200" cy="200" r="150" fill="none" stroke="#C46E1F" stroke-width="2.4" stroke-dasharray="2 9" stroke-linecap="round" opacity="0.85"/>
        <circle cx="200" cy="200" r="150" fill="none" stroke="#C46E1F" stroke-width="6"
                stroke-dasharray="518.36 9999" stroke-linecap="round"
                transform="rotate(-90 200 200)"/>
        <g stroke="#0A0907" stroke-width="4" fill="none">
            <line x1="200" y1="150" x2="243" y2="175"/>
            <line x1="243" y1="175" x2="243" y2="225"/>
            <line x1="243" y1="225" x2="200" y2="250"/>
            <line x1="200" y1="250" x2="157" y2="225"/>
            <line x1="157" y1="225" x2="157" y2="175"/>
            <line x1="157" y1="175" x2="200" y2="150"/>
        </g>
        <g stroke="#C46E1F" stroke-width="6" fill="none" stroke-linecap="round">
            <path d="M 200 150 Q 210 100 200 50"/>
            <path d="M 243 225 Q 295 245 330 275"/>
            <path d="M 157 225 Q 105 245 70 275"/>
        </g>
        <g fill="#C46E1F">
            <circle cx="200" cy="50" r="11"/>
            <circle cx="330" cy="275" r="11"/>
            <circle cx="70" cy="275" r="11"/>
        </g>
        <g fill="#0A0907">
            <circle cx="243" cy="175" r="5"/>
            <circle cx="200" cy="250" r="5"/>
            <circle cx="157" cy="175" r="5"/>
            <circle cx="200" cy="150" r="6"/>
            <circle cx="243" cy="225" r="6"/>
            <circle cx="157" cy="225" r="6"/>
        </g>
    </svg>
{% endmacro %}

{% macro toqueIcon(sizeClass) %}
    <svg class="{{ sizeClass|default('size-6') }}" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M 9 11 C 5 10, 4 4, 9 4 C 11 1.5, 14 1.5, 16 3.5 C 18 1.5, 21 1.5, 23 4 C 28 4, 27 10, 23 11"/>
        <path d="M 9 11 L 9 22"/>
        <path d="M 23 11 L 23 22"/>
        <rect x="7" y="22" width="18" height="5" rx="0.6"/>
        <path d="M 12.5 11 L 12.5 22" opacity="0.5"/>
        <path d="M 19.5 11 L 19.5 22" opacity="0.5"/>
        <circle cx="16" cy="24.5" r="1.1" fill="#C46E1F" stroke="none"/>
    </svg>
{% endmacro %}

{% macro navItem(href, title, sub, active) %}
    <li>
        <a href="{{ href }}" class="nav-item" @click="close()"{% if active %} aria-current="page"{% endif %}>
            <span>
                <span class="nav-item-title">{{ title }}</span>
                {% if sub %}<span class="nav-item-sub">{{ sub }}</span>{% endif %}
            </span>
            <span class="nav-item-arrow" aria-hidden="true">→</span>
        </a>
    </li>
{% endmacro %}

{% import _self as n %}

{% set _route = app.request.attributes.get('_canonical_route') ?? app.request.attributes.get('_route') %}
{% set _isUser = is_granted('ROLE_USER') %}
{% set _gamif = gamification_on() %}
{% set _onLab = _route in ['index_spicy_match', 'view_spicy_match'] %}
{% set _switchQuery = app.request.queryString ? '?' ~ app.request.queryString : '' %}
{% set _switchTargets = locale_alternates()|map(p => p ~ _switchQuery) %}

<div x-data="navMenu" class="site-nav-root">

<header class="site-nav">
    <nav class="site-nav-inner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="{{ 'ui.navbar.main_nav'|trans }}">

        <div class="site-nav-side">
            <button type="button"
                    @click="toggle()"
                    x-bind:class="{ 'is-open': open }"
                    x-bind:aria-expanded="open.toString()"
                    aria-expanded="false"
                    aria-controls="nav-panel"
                    aria-label="{{ 'ui.navbar.main_menu'|trans }}"
                    class="toque-btn hidden lg:inline-flex">
                {{ n.toqueIcon('size-[26px]') }}
                <span class="toque-btn-text">
                    <span class="toque-btn-kicker" x-text="toqueLabel()">{{ 'nav.open'|trans({}, 'js') }}</span>
                    <span class="toque-btn-label">{{ 'ui.navbar.menu'|trans }}</span>
                </span>
            </button>

            <a href="{{ path('index_spicy_match') }}"
               class="nav-icon-btn lg:hidden"
               aria-label="{{ 'ui.navbar.create_blend'|trans }}"
               {% if _onLab %}aria-current="page"{% endif %}>
                <i class="fa-solid fa-mortar-pestle text-sm" aria-hidden="true"></i>
            </a>
        </div>

        <a href="{{ path('home') }}" class="site-nav-logo" aria-label="{{ 'ui.navbar.home'|trans }}"
           {% if _route == 'home' %}aria-current="page"{% endif %}>
            {{ n.herbierLogo('site-nav-logo-mark') }}
            <span class="site-nav-wordmark" aria-hidden="true">Spicy <em>Match</em></span>
        </a>

        <div class="site-nav-side">
            <a href="{{ path('index_spicy_match') }}"
               class="nav-cta hidden lg:inline-flex"
               {% if _onLab %}aria-current="page"{% endif %}>
                <i class="fa-solid fa-mortar-pestle text-xs" aria-hidden="true"></i>
                {{ 'ui.navbar.compose'|trans }}
            </a>

            {% if _isUser %}
                {% include 'components/_profile_menu.html.twig' with {route: _route, gamif: _gamif} only %}
            {% else %}
                <a href="{{ path('app_login') }}"
                   x-data="gateTrigger('', 'login')" @click="trigger($event)"
                   class="nav-login hidden lg:inline-flex">
                    {{ 'ui.common.login'|trans }}
                </a>
                <a href="{{ path('app_login') }}"
                   x-data="gateTrigger('', 'login')" @click="trigger($event)"
                   class="nav-icon-btn lg:hidden"
                   aria-label="{{ 'ui.common.login'|trans }}">
                    <i class="fa-solid fa-user text-sm" aria-hidden="true"></i>
                </a>
            {% endif %}

            <button type="button"
                    @click="toggle()"
                    x-bind:class="{ 'is-open': open }"
                    x-bind:aria-expanded="open.toString()"
                    x-bind:aria-label="mobileToqueLabel()"
                    aria-expanded="false"
                    aria-controls="nav-panel"
                    aria-label="{{ 'nav.menu_open'|trans({}, 'js') }}"
                    class="nav-icon-btn lg:hidden">
                {{ n.toqueIcon('size-[22px]') }}
            </button>
        </div>

    </nav>
</header>

<div class="nav-backdrop" x-bind:class="{ 'is-open': open }" @click="close()" aria-hidden="true"></div>

<nav id="nav-panel"
     class="nav-panel"
     x-bind:class="{ 'is-open': open }"
     aria-label="{{ 'ui.navbar.main_menu'|trans }}">
    <div class="nav-panel-inner">

        <a href="{{ path('home') }}" class="nav-panel-brand" @click="close()" aria-label="{{ 'ui.navbar.home'|trans }}">
            <span class="site-nav-wordmark" aria-hidden="true">Spicy <em>Match</em></span>
        </a>

        <div class="nav-panel-search">{{ component('Search') }}</div>

        <div class="nav-panel-grid">

            <div class="nav-lab-card">
                <span class="nav-lab-icon" aria-hidden="true"><i class="fa-solid fa-mortar-pestle"></i></span>
                <span class="nav-lab-eyebrow">{{ 'ui.navbar.lab_eyebrow'|trans }}</span>
                <p class="nav-lab-title">{{ 'ui.navbar.alchemy_title'|trans }}</p>
                <p class="nav-lab-text">{{ 'ui.navbar.lab_card_text'|trans }}</p>
                <a href="{{ path('index_spicy_match') }}" class="nav-lab-cta" @click="close()"
                   {% if _onLab %}aria-current="page"{% endif %}>
                    {{ 'ui.navbar.create_blend'|trans }} <span aria-hidden="true">→</span>
                </a>
            </div>

            <div class="nav-links">
                <ul class="nav-items">
                    {{ n.navItem(path('index_spices'), 'ui.navbar.catalog_title'|trans, 'ui.navbar.catalog_sub'|trans, _route == 'index_spices') }}
                    {{ n.navItem(path('index_aromatic_groups'), 'ui.navbar.groups_title'|trans, 'ui.navbar.groups_sub'|trans, _route == 'index_aromatic_groups') }}
                    {{ n.navItem(path('index_alchemy_flavors'), 'ui.navbar.flavors_title'|trans, 'ui.navbar.flavors_sub'|trans, _route == 'index_alchemy_flavors') }}
                    {{ n.navItem(path('index_aromatic_compound'), 'ui.navbar.compounds_title'|trans, 'ui.navbar.compounds_sub'|trans, _route == 'index_aromatic_compound') }}
                    {{ n.navItem(path('index_spicy_type'), 'ui.navbar.spicy_types_title'|trans, 'ui.navbar.spicy_types_sub'|trans, _route == 'index_spicy_type') }}
                    {{ n.navItem(path('index_preparation_methods'), 'ui.navbar.methods_title'|trans, 'ui.navbar.methods_sub'|trans, _route == 'index_preparation_methods') }}
                </ul>
                {% if _gamif %}
                    <ul class="nav-items nav-items-academy">
                        {{ n.navItem(path('education_index'), 'ui.common.academy'|trans, 'ui.navbar.academy_sub'|trans, _route == 'education_index') }}
                    </ul>
                {% endif %}
            </div>

        </div>

        <div class="nav-panel-foot">
            <div class="nav-panel-foot-links">
                <a href="{{ path('help_index') }}" class="nav-foot-link" @click="close()"
                   {% if _route == 'help_index' %}aria-current="page"{% endif %}>{{ 'ui.navbar.help'|trans }}</a>
                <a href="{{ path('new_contact') }}" class="nav-foot-link" @click="close()"
                   {% if _route == 'new_contact' %}aria-current="page"{% endif %}>{{ 'ui.common.contact'|trans }}</a>
                {% if _isUser %}
                    <a href="{{ path('profile_user') }}" class="nav-foot-link" @click="close()">{{ 'ui.navbar.my_space'|trans }}</a>
                    <a href="{{ logout_path() }}" class="nav-foot-link">{{ 'ui.common.logout'|trans }}</a>
                {% endif %}
            </div>

            <div class="nav-locales">
                {% for loc in app.enabled_locales %}
                    <a href="{{ path('switch_locale', {locale: loc, target: _switchTargets[loc] ?? app.request.requestUri}) }}"
                       hreflang="{{ loc }}"
                       lang="{{ loc }}"
                       aria-label="{{ loc|locale_name(loc)|capitalize }}"
                       data-turbo="false"
                       class="nav-locale"
                       {% if app.request.locale == loc %}aria-current="true"{% endif %}>{{ loc }}</a>
                {% endfor %}
            </div>
        </div>

    </div>
</nav>

</div>
