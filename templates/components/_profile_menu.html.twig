{% set _prog = app.user.progression %}
{% set _badge = _prog ? _prog.equippedBadge : null %}
{% set _showProg = _prog and gamif %}
{% set _name = app.user.username %}
{% if _showProg %}
    {% set _lvl = _prog.level %}
    {% set _grade = _prog.grade.label|trans %}
    {% set _pct = min(100, max(0, _prog.progressPercent))|round %}
    {% set _streak = _prog.currentActivityStreak %}
{% endif %}
{% set _pillLabel = 'ui.navbar.profile_menu'|trans({'%name%': _name}) %}
{% if _showProg %}
    {% set _pillLabel = _pillLabel ~ ', ' ~ 'ui.dashboard.level_short'|trans({'%level%': _lvl}) ~ ', ' ~ 'ui.navbar.profile_progress'|trans({'%percent%': _pct}) %}
{% endif %}
{% set _onProfile = route == 'profile_user' %}
{% set _items = [
    {params: {tab: 'dashboard'}, label: 'ui.profile.menu.dashboard'|trans, icon: 'fa-solid fa-gauge-high'},
    {params: {tab: 'grimoire'}, label: 'ui.profile.menu.grimoire'|trans, icon: 'fa-solid fa-book-open'},
    {params: {tab: 'history'}, label: 'ui.profile.menu.history'|trans, icon: 'fa-solid fa-clock-rotate-left'},
    {params: {tab: 'history', filter: 'favorites'}, label: 'ui.profile.menu.favorites'|trans, icon: 'fa-solid fa-star'},
    {params: {tab: 'lab'}, label: 'ui.profile.menu.lab'|trans, icon: 'fa-solid fa-flask'},
] %}

<div class="profile-menu" @click.outside="closeProfile(false)" @focusout="onProfileFocusOut($event)">
    <button type="button"
            x-ref="profileTrigger"
            data-tour="nav-profile"
            @click="toggleProfile()"
            x-bind:class="{ 'is-open': profileOpen }"
            x-bind:aria-expanded="profileOpen.toString()"
            aria-expanded="false"
            aria-controls="nav-profile-card"
            aria-label="{{ _pillLabel }}"
            class="profile-pill{{ _onProfile ? ' is-current' : '' }}">
        {% include 'components/_avatar.html.twig' with {sizeClass: 'size-7 text-xs', equippedBadge: _badge} only %}
        <span class="profile-pill-name">
            <span class="profile-pill-username">{{ _name }}</span>
            {% if _showProg %}<span class="profile-pill-grade">{{ _grade }}</span>{% endif %}
        </span>
        {% if _showProg %}
            <span class="profile-pill-level" aria-hidden="true">
                <span class="profile-pill-level-short">{{ _lvl }}</span>
                <span class="profile-pill-level-full">{{ 'ui.dashboard.level_short'|trans({'%level%': _lvl}) }}</span>
            </span>
            <span class="profile-pill-gauge" aria-hidden="true"><span class="profile-pill-gauge-fill" style="width: {{ _pct }}%"></span></span>
        {% endif %}
        <span class="profile-pill-chevron" aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>
    </button>

    <div id="nav-profile-card"
         class="profile-card"
         x-bind:class="{ 'is-open': profileOpen }">
        <div class="profile-card-head">
            {% include 'components/_avatar.html.twig' with {sizeClass: 'size-11 text-base', equippedBadge: _badge} only %}
            <div class="min-w-0">
                <p class="profile-card-name">{{ _name }}</p>
                {% if _showProg %}
                    <p class="profile-card-grade">{{ _grade }} · {{ 'ui.dashboard.level_short'|trans({'%level%': _lvl}) }}</p>
                {% endif %}
            </div>
        </div>

        {% if _showProg %}
            <div class="profile-card-progress">
                <div class="profile-card-bar"
                     role="progressbar"
                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ _pct }}"
                     aria-label="{{ 'ui.navbar.profile_progress'|trans({'%percent%': _pct}) }}">
                    <span class="profile-card-bar-fill" style="width: {{ _pct }}%"></span>
                </div>
                <div class="profile-card-meta">
                    <span>{{ 'ui.dashboard.xp_to_next'|trans({'%xp%': _prog.xp, '%toNext%': _prog.xpToNextLevel}) }}</span>
                    {% if _streak > 0 %}
                        <span class="profile-card-streak"><i class="fa-solid fa-fire" aria-hidden="true"></i> {{ 'ui.navbar.streak'|trans({'%count%': _streak}) }}</span>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <ul class="profile-card-links">
            {% for item in _items %}
                <li>
                    <a href="{{ path('profile_user', item.params) }}" class="profile-card-link" @click="closeProfile(false)">
                        <i class="{{ item.icon }}" aria-hidden="true"></i>{{ item.label }}
                    </a>
                </li>
            {% endfor %}
        </ul>

        <a href="{{ logout_path() }}" class="profile-card-logout">
            <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>{{ 'ui.profile.menu.logout'|trans }}
        </a>
    </div>
</div>
