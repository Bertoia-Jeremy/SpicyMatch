<div class="flex flex-nowrap overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden border-b border-spice-border mt-6" role="tablist"
     aria-label="{{ 'ui.profile.tabs.aria_label'|trans }}"
     x-on:keydown="tabKey($event)">
    {% set items = [
        { key: 'dashboard', label: 'ui.profile.tabs.dashboard'|trans, icon: 'fa-solid fa-gauge-high' },
        { key: 'grimoire',  label: 'ui.profile.tabs.grimoire'|trans,  icon: 'fa-solid fa-book-open' },
        { key: 'history',   label: 'ui.profile.tabs.history'|trans,   icon: 'fa-solid fa-clock-rotate-left' },
        { key: 'lab',       label: 'ui.profile.tabs.lab'|trans,       icon: 'fa-solid fa-flask' },
    ] %}
    {% for item in items %}
        {% set active = item.key == activeTab %}
        <button type="button" role="tab"
                id="tab-{{ item.key }}"
                aria-controls="tabpanel-{{ item.key }}"
                aria-selected="{{ active ? 'true' : 'false' }}"
                tabindex="{{ active ? 0 : -1 }}"
                x-bind:aria-selected="isActive('{{ item.key }}').toString()"
                x-bind:tabindex="isActive('{{ item.key }}') ? 0 : -1"
                x-on:click="go('{{ item.key }}')"
                class="shrink-0 whitespace-nowrap px-4 py-2 text-sm font-medium transition-colors border-b-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-saffron-600"
                x-bind:class="isActive('{{ item.key }}') ? 'text-saffron-700 border-saffron-700' : 'text-stone-600 border-transparent hover:text-stone-800 hover:border-stone-300'">
            <i class="{{ item.icon }} text-xs mr-1" aria-hidden="true"></i>{{ item.label }}
        </button>
    {% endfor %}
</div>
