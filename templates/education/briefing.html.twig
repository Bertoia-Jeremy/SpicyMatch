{% extends 'base.html.twig' %}

{% block title %}{{ mode.label|trans }} — {{ 'ui.edu.presentation'|trans }}{% endblock %}

{% block body %}
{% set motifParts = {qcm: 4, hangman: 6, guess_who: 3, intrus: 4, survival: 5, chrono: 1}[mode.value] %}
<article class="brief" data-game-mode="{{ mode.value }}" x-data="briefing" data-difficulty="{{ difficulty.value }}">
  <header class="brief-hero">
    <div class="brief-hero-inner">
      <div class="brief-motif" aria-hidden="true">
        {% for i in 1..motifParts %}<span class="brief-motif-part"></span>{% endfor %}
      </div>
      <div class="brief-hero-body">
        <p class="brief-eyebrow">
          <i class="{{ mode.icon }}" aria-hidden="true"></i>
          <span>{{ 'ui.edu.briefing.required_level'|trans({'%level%': mode.requiredLevel}) }}</span>
        </p>
        <h1 class="brief-title">{{ mode.titleTop|trans }} <span class="ital">{{ mode.titleBottom|trans }}</span></h1>
        <p class="brief-promise">{{ mode.promise|trans }}</p>
        <ul class="brief-chips">
          <li class="brief-chip"><i class="fa-solid fa-star" aria-hidden="true"></i>{{ 'ui.edu.xp_per_answer'|trans({'%xp%': mode.xpPerCorrect}) }}</li>
          <li class="brief-chip">
            <i class="fa-solid fa-list-ol" aria-hidden="true"></i>
            {{ mode.totalQuestions ? 'ui.edu.questions'|trans({'%count%': mode.totalQuestions}) : 'ui.edu.unlimited'|trans }}
          </li>
          {% if mode.isFullscreen %}
            <li class="brief-chip"><i class="fa-solid fa-expand" aria-hidden="true"></i>{{ 'ui.edu.briefing.fullscreen'|trans }}</li>
          {% endif %}
          {% if view.dailyBonus %}
            <li class="brief-chip brief-chip-bonus"><i class="fa-solid fa-bolt" aria-hidden="true"></i>{{ 'ui.edu.briefing.daily_bonus'|trans }}</li>
          {% endif %}
        </ul>
      </div>
    </div>
  </header>

  <div class="brief-container">
    <dl class="brief-status" aria-label="{{ 'ui.edu.briefing.status'|trans }}">
      <div class="brief-stat">
        <dt class="brief-stat-label">{{ 'ui.edu.briefing.played_today'|trans }}</dt>
        <dd class="brief-stat-value">{{ view.playedToday }}<span class="brief-stat-total">/{{ view.maxDailySessions }}</span></dd>
        <dd class="brief-stat-meter">
          <meter class="brief-meter" min="0" max="{{ view.maxDailySessions }}" value="{{ view.playedToday }}"
                 aria-label="{{ 'ui.edu.briefing.played_today'|trans }}">{{ view.playedToday }}/{{ view.maxDailySessions }}</meter>
        </dd>
        {% if not view.premium %}
          <dd class="brief-stat-hint">{{ 'ui.edu.briefing.premium_hint'|trans({'%max%': view.premiumMaxDailySessions}) }}</dd>
        {% endif %}
      </div>
      <div class="brief-stat">
        <dt class="brief-stat-label">{{ 'ui.edu.briefing.record'|trans }}</dt>
        <dd class="brief-stat-value">{{ view.best is not null ? 'ui.edu.briefing.record_value'|trans({'%xp%': view.best|format_number}) : 'ui.edu.record_none'|trans }}</dd>
      </div>
      <div class="brief-stat">
        <dt class="brief-stat-label">{{ 'ui.edu.briefing.xp_cap'|trans }}</dt>
        <dd class="brief-stat-value">{{ 'ui.edu.briefing.xp_cap_value'|trans({'%xp%': view.maxXpPerSession}) }}</dd>
      </div>
    </dl>

    <section class="brief-section" aria-labelledby="brief-rules-title">
      <h2 id="brief-rules-title" class="brief-section-title">{{ 'ui.edu.rules'|trans }}</h2>
      <ol class="brief-rules">
        {% for rule in view.rules %}
          <li class="brief-rule">{{ rule }}</li>
        {% endfor %}
      </ol>
    </section>

    <form method="post" action="{{ path('education_start') }}" data-turbo="false" class="brief-form"
          x-on:submit="submitting = true" x-on:pageshow.window="submitting = false">
      <input type="hidden" name="_token" value="{{ csrf_token('education_start') }}">
      <input type="hidden" name="mode" value="{{ mode.value }}">

      <fieldset class="brief-diff">
        <legend class="brief-section-title">{{ 'ui.edu.briefing.choose_difficulty'|trans }}</legend>
        <div class="brief-diff-grid">
          {% for diff in difficulties %}
            <label class="brief-diff-option">
              <input type="radio" name="difficulty" value="{{ diff.value }}" class="brief-diff-input sr-only"
                     x-model="difficulty"{% if diff == difficulty %} checked{% endif %}>
              <span class="brief-diff-card">
                <span class="brief-diff-peppers" aria-hidden="true">
                  {% for i in 1..3 %}<span class="brief-pepper{{ i <= diff.rank ? ' is-lit' : '' }}"><i class="fa-solid fa-pepper-hot"></i></span>{% endfor %}
                </span>
                <span class="brief-diff-label">{{ diff.label|trans }}</span>
                <span class="brief-diff-mult">{{ 'ui.edu.briefing.multiplier'|trans({'%value%': diff.xpMultiplier|format_number}) }}</span>
              </span>
            </label>
          {% endfor %}
        </div>
      </fieldset>

      <section class="brief-stakes" aria-labelledby="brief-stakes-title">
        <h2 id="brief-stakes-title" class="brief-stakes-title">{{ 'ui.edu.briefing.stakes'|trans }}</h2>
        <dl class="brief-facts" aria-live="polite">
          {% for fact in view.facts %}
            <div class="brief-fact">
              <dt class="brief-fact-label"><i class="{{ fact.icon }}" aria-hidden="true"></i>{{ fact.label|trans }}</dt>
              <dd class="brief-fact-value">
                <span data-easy="{{ fact.values.easy }}" data-medium="{{ fact.values.medium }}" data-hard="{{ fact.values.hard }}"
                      x-text="valueFor($el)">{{ fact.valueFor(difficulty) }}</span>
                {%- if fact.unit %} {{ fact.unit|trans }}{% endif %}
              </dd>
            </div>
          {% endfor %}
        </dl>
        <a href="{{ path('profile_tab', {tab: 'lab'}) }}" class="brief-link">
          <i class="fa-solid fa-sliders" aria-hidden="true"></i>{{ 'ui.edu.default_difficulty_link'|trans }}
        </a>
      </section>

      <div class="brief-actions">
        <twig:Button label="{{ 'ui.edu.all_modes'|trans }}" variant="back" href="{{ path('education_index') }}" />
        {% if view.levelLocked %}
          <p class="brief-blocked" role="status">
            <i class="fa-solid fa-lock" aria-hidden="true"></i>{{ 'ui.edu.locked_level_hint'|trans({'%mode%': mode.label|trans, '%level%': mode.requiredLevel}) }}
          </p>
        {% elseif view.remainingToday <= 0 %}
          <p class="brief-blocked" role="status">
            <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>{{ 'ui.edu.come_back_tomorrow'|trans }}
          </p>
        {% elseif mode.isLiveComponent %}
          <twig:Button label="{{ 'ui.edu.play'|trans }}" variant="primary" size="lg" type="submit" icon="fa-solid fa-play" x-bind:disabled="submitting" />
        {% else %}
          <twig:Button label="{{ 'ui.edu.launch_brigade'|trans }}" variant="primary" size="lg" type="submit" icon="fa-solid fa-fire-burner" x-bind:disabled="submitting" />
        {% endif %}
      </div>
    </form>
  </div>
</article>
{% endblock %}
