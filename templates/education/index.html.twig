{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.edu.academy_title'|trans }}{% endblock %}

{% block body %}
<div class="max-w-[1360px] mx-auto px-6 sm:px-10 lg:px-14 py-10 md:py-14">
  <div class="section-head" style="margin-bottom: 44px">
    <h1 class="font-display font-medium leading-none tracking-[-0.015em] m-0" style="font-size: clamp(40px, 5vw, 80px); color: var(--color-ink-900)">
      {{ 'ui.edu.academy_title'|trans }}
    </h1>
    <p class="section-blurb">{{ 'ui.edu.academy_intro'|trans }}</p>
  </div>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="mb-4 px-4 py-3 rounded-lg text-sm
        {{ label == 'warning' ? 'bg-turmeric-100 text-turmeric-800 border border-turmeric-300' : '' }}
        {{ label == 'error' ? 'bg-red-100 text-red-800 border border-red-300' : '' }}
        {{ label == 'success' ? 'bg-green-100 text-green-800 border border-green-300' : '' }}">
        {{ message }}
      </div>
    {% endfor %}
  {% endfor %}

  {% if progression is not null %}
    <div class="academie-rail">
      <div class="academie-rank">
        <div class="academie-seal">{{ progression.level }}</div>
        <div>
          <div class="who">{{ 'ui.edu.level_label'|trans({'%level%': progression.level}) }}</div>
          <div class="lvl">{{ progression.xp|number_format(0, ',', ' ') }} XP</div>
        </div>
      </div>
      <div class="academie-xp">
        <div class="academie-xp-top">
          <span>{{ 'ui.edu.next_level'|trans }}</span>
          <span>{{ progression.xpToNextLevel }} XP</span>
        </div>
        <div class="academie-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="{{ progression.progressPercent }}" aria-label="{{ 'ui.edu.level_progress'|trans }}">
          <i style="width:{{ progression.progressPercent }}%"></i>
        </div>
      </div>
      <div class="academie-stat"><b>{{ gamesPlayed }}</b><span>{{ 'ui.edu.games_played'|trans }}</span></div>
      <div class="academie-stat flame">
        <b>{{ achievementsUnlocked }}<span style="font-size:16px;opacity:.5">/{{ achievementsTotal }}</span></b>
        <span>{{ 'ui.edu.achievements_stat'|trans }}</span>
      </div>
    </div>
  {% endif %}

  {% set romans = ['I', 'II', 'III', 'IV', 'V', 'VI'] %}
  <div data-tour="game-grid" class="poster-grid">
    {% for mode in modes %}
      {% set count = dailyCounts[mode.value] ?? 0 %}
      {% set remaining = maxDailySessions - count %}
      {% set levelLocked = is_granted('ROLE_USER') and not (unlockedByMode[mode.value] ?? true) %}
      {% set locked = (is_granted('ROLE_USER') and remaining <= 0) or levelLocked %}
      {% set cardUrl = path('education_briefing', { mode: mode.value, difficulty: userDifficulty }) %}
      {% set best = bestScores[mode.value] ?? null %}
      {% set isDaily = mode == dailyFeaturedMode and not locked %}
      {% set lockedHint = levelLocked ? 'ui.edu.locked_level_hint'|trans({'%mode%': mode.label|trans, '%level%': mode.requiredLevel}) : 'ui.edu.locked_hint'|trans %}
      <div>
        {% if locked %}
        <a href="{{ cardUrl }}" aria-disabled="true" tabindex="-1" class="poster is-locked"
           style="background:{{ mode.posterGradient }}"
           aria-label="{{ mode.label|trans }} — {{ mode.tagline|trans }} — {{ lockedHint }}">
        {% elseif is_granted('ROLE_USER') %}
        <a href="{{ cardUrl }}" class="poster" style="background:{{ mode.posterGradient }}"
           aria-label="{{ mode.label|trans }} — {{ mode.tagline|trans }}">
        {% else %}
        <a href="{{ cardUrl }}" x-data="gateTrigger('{{ cardUrl|e('js') }}')" @click="trigger($event)"
           class="poster" style="background:{{ mode.posterGradient }}"
           aria-label="{{ mode.label|trans }} — {{ mode.tagline|trans }}">
        {% endif %}
          {% if levelLocked %}<i class="fa-solid fa-lock poster-lock" aria-hidden="true"></i>{% endif %}
          {% if isDaily %}<span class="poster-ribbon">{{ 'ui.edu.daily_challenge'|trans }}</span>{% endif %}
          <div class="poster-top">
            <div class="poster-num">{{ 'ui.edu.lesson'|trans({'%numeral%': romans[loop.index0]}) }}</div>
            <div class="poster-ornament" aria-hidden="true">✦</div>
          </div>
          <div class="poster-mid">
            <h3>{{ mode.titleTop|trans }}<span class="ital">{{ mode.titleBottom|trans }}</span></h3>
            <div class="poster-dash" aria-hidden="true"></div>
            <div class="poster-tag">{{ mode.tagline|trans }}</div>
          </div>
          <div class="poster-bot">
            <span>
              {% if mode.totalQuestions %}
                {{ 'ui.edu.questions'|trans({'%count%': mode.totalQuestions}) }}
              {% elseif mode.value == 'chrono' %}
                {{ 'ui.edu.timed_mode'|trans }}
              {% elseif mode.value == 'survival' %}
                {{ 'ui.edu.survival_mode'|trans }}
              {% else %}
                {{ 'ui.edu.unlimited_questions'|trans }}
              {% endif %}
            </span>
            <span class="right">{{ best is not null ? 'ui.edu.record_label'|trans({'%score%': best}) : 'ui.edu.record_none'|trans }}</span>
          </div>
          <span class="poster-play">{{ 'ui.edu.play'|trans }}</span>
        </a>
        {% if is_granted('ROLE_USER') %}
          <p class="mt-2 text-center text-xs text-stone-500">
            {% if levelLocked %}
              <span class="text-paprika-700 font-medium"><i class="fa-solid fa-lock mr-1" aria-hidden="true"></i>{{ lockedHint }}</span>
            {% elseif remaining <= 0 %}
              <span class="text-paprika-700 font-medium"><i class="fa-solid fa-clock-rotate-left mr-1" aria-hidden="true"></i>{{ 'ui.edu.come_back_tomorrow'|trans }}</span>
            {% elseif count >= reducedXpThreshold %}
              <span class="text-turmeric-700" title="{{ 'ui.edu.reduced_xp_tooltip'|trans({'%threshold%': reducedXpThreshold}) }}">{{ 'ui.edu.remaining_xp'|trans({'%count%': remaining}) }}</span>
            {% else %}
              {{ 'ui.edu.remaining_today'|trans({'%remaining%': remaining, '%max%': maxDailySessions}) }}
            {% endif %}
          </p>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if recentSessions is not empty %}
    <div class="bg-white border border-stone-200 rounded-2xl shadow-sm p-6 mt-12">
      <h2 class="text-xl font-semibold text-stone-800 mb-4">{{ 'ui.edu.recent_games'|trans }}</h2>
      <div class="space-y-3">
        {% for session in recentSessions %}
          <div class="flex items-center justify-between px-4 py-3 rounded-lg border border-stone-200">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-stone-100 text-stone-500">
                <i class="{{ session.gameMode.icon }} text-sm"></i>
              </div>
              <span class="text-sm font-medium text-stone-800">{{ session.gameMode.label|trans }}</span>
            </div>
            <div class="flex items-center gap-4 text-sm text-stone-600">
              {% if session.isFinished %}
                <span>{{ 'ui.edu.correct_count'|trans({'%correct%': session.correctAnswers, '%total%': session.totalQuestions}) }}</span>
                <span class="font-semibold text-saffron-600">+{{ session.score }} XP</span>
              {% else %}
                <span class="text-turmeric-600 font-medium">{{ 'ui.edu.in_progress'|trans }}</span>
              {% endif %}
              <span class="text-xs text-stone-400">{{ session.startedAt|format_date('short') }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="mt-12">
    {% include 'partials/_ads_banner.html.twig' %}
  </div>
</div>
{% endblock %}
