{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.edu.result_title'|trans({'%mode%': session.gameMode.label|trans}) }}{% endblock %}

{% block body %}
{% set gamif = gamification_on() %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <div class="bg-white border border-stone-200 rounded-2xl shadow-sm p-8 text-center mb-8">
    <div class="flex items-center justify-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-saffron-100 text-saffron-600">
        <i class="{{ session.gameMode.icon }}"></i>
      </div>
      <h1 class="text-2xl font-bold text-stone-800">{{ session.gameMode.label|trans }}</h1>
    </div>

    {% if session.gameMode.value == 'survival' %}
      <div class="w-32 h-32 mx-auto mb-6 rounded-full border-8 border-saffron-400 text-saffron-700 flex items-center justify-center">
        <div>
          <div class="text-3xl font-bold">{{ session.correctAnswers }}</div>
          <div class="text-xs"><i class="fa-solid fa-link" aria-hidden="true"></i></div>
        </div>
      </div>

      <div class="grid {{ gamif ? 'grid-cols-2' : 'grid-cols-1' }} gap-4 mb-6">
        <div class="text-center">
          <div class="text-2xl font-bold text-stone-800">{{ session.correctAnswers }}</div>
          <div class="text-xs text-stone-500">{{ 'ui.edu.chain_unit'|trans }}</div>
        </div>
        {% if gamif %}
          <div class="text-center">
            <div class="text-2xl font-bold text-saffron-600">+{{ session.score }}</div>
            <div class="text-xs text-stone-500">{{ 'ui.edu.xp_earned'|trans }}</div>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="w-32 h-32 mx-auto mb-6 rounded-full border-8 flex items-center justify-center
        {{ session.accuracy >= 80 ? 'border-green-400 text-green-700' : (session.accuracy >= 50 ? 'border-turmeric-400 text-turmeric-700' : 'border-red-400 text-red-700') }}">
        <div>
          <div class="text-3xl font-bold">{{ session.accuracy|round }}%</div>
          <div class="text-xs">{{ 'ui.edu.precision'|trans }}</div>
        </div>
      </div>

      <div class="grid {{ gamif ? 'grid-cols-3' : 'grid-cols-2' }} gap-4 mb-6">
        <div class="text-center">
          <div class="text-2xl font-bold text-stone-800">{{ session.correctAnswers }}</div>
          <div class="text-xs text-stone-500">{{ 'ui.edu.good_answers'|trans }}</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-stone-800">{{ session.totalQuestions - session.correctAnswers }}</div>
          <div class="text-xs text-stone-500">{{ 'ui.edu.errors'|trans }}</div>
        </div>
        {% if gamif %}
          <div class="text-center">
            <div class="text-2xl font-bold text-saffron-600">+{{ session.score }}</div>
            <div class="text-xs text-stone-500">{{ 'ui.edu.xp_earned'|trans }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="flex flex-wrap justify-center gap-2 text-sm text-stone-500 mb-6">
      <span class="tag-secondary">{{ session.difficulty.label|trans }}</span>
      {% if gamif and session.dailyBonus %}
        <span class="tag-secondary"><i class="fa-solid fa-bolt mr-1 text-saffron-600" aria-hidden="true"></i>{{ 'ui.edu.daily_bonus_applied'|trans }}</span>
      {% endif %}
      {% if session.durationSeconds %}
        <span class="tag-secondary">
          <i class="fa-solid fa-clock mr-1" aria-hidden="true"></i>{{ (session.durationSeconds / 60)|round(0, 'floor') }}min {{ session.durationSeconds % 60 }}s
        </span>
      {% endif %}
    </div>

    {% if gamif and session.isFinished %}
      <p class="mb-6 text-sm" data-record>
        {% if isNewRecord %}
          <span class="inline-flex items-center gap-2 rounded-full bg-saffron-100 px-4 py-1.5 font-semibold text-saffron-700">
            <i class="fa-solid fa-trophy" aria-hidden="true"></i>{{ 'ui.edu.new_record'|trans }}
          </span>
        {% elseif personalBest is not null %}
          <span class="text-stone-600">
            <i class="fa-solid fa-trophy mr-1 text-turmeric-600" aria-hidden="true"></i>{{ 'ui.edu.record_result'|trans({'%score%': personalBest}) }}
          </span>
        {% endif %}
      </p>
    {% endif %}

    <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 justify-center">
      {% if not canReplay or not gamif %}
        <twig:Button
            label="{{ 'ui.edu.come_back_tomorrow'|trans }}"
            variant="primary"
            icon="fa-solid fa-clock-rotate-left"
            disabled="{{ true }}" />
      {% elseif session.gameMode.isLiveComponent %}
        <twig:Button
            label="{{ 'ui.edu.replay'|trans }}"
            variant="primary"
            icon="fa-solid fa-rotate-right"
            href="{{ path('education_play_live', { mode: session.gameMode.value, difficulty: session.difficulty.value }) }}" />
      {% else %}
        <twig:Button
            label="{{ 'ui.edu.replay'|trans }}"
            variant="primary"
            icon="fa-solid fa-rotate-right"
            href="{{ path('education_briefing', { mode: session.gameMode.value, difficulty: session.difficulty.value }) }}" />
      {% endif %}
      <twig:Button
          label="{{ 'ui.edu.all_modes'|trans }}"
          variant="secondary"
          icon="fa-solid fa-gamepad"
          href="{{ path('education_index') }}" />
      <twig:Button
          label="{{ 'ui.edu.dashboard'|trans }}"
          variant="secondary"
          icon="fa-solid fa-gauge-high"
          href="{{ path('profile_user') }}" />
    </div>
  </div>

  {% if skillAssessment is not null %}
    {% set fromLabel = skillAssessment.current.label|trans %}
    {% set toLabel = skillAssessment.suggested.label|trans %}
    {% set skillParams = {
      '%rate%': skillAssessment.winrate,
      '%count%': skillAssessment.samples,
      '%from%': fromLabel,
      '%to%': toLabel
    } %}
    <div class="card-warm p-6 mb-8 flex flex-col sm:flex-row sm:items-center gap-4">
      <div class="w-10 h-10 shrink-0 rounded-xl flex items-center justify-center
        {{ skillAssessment.isPromotion ? 'bg-saffron-100 text-saffron-600' : 'bg-stone-100 text-stone-500' }}">
        <i class="fa-solid {{ skillAssessment.isPromotion ? 'fa-arrow-trend-up' : 'fa-scale-balanced' }}" aria-hidden="true"></i>
      </div>
      <div class="flex-1 min-w-0">
        <p class="font-semibold text-stone-800">
          {{ (skillAssessment.isPromotion ? 'ui.edu.skill.up_title' : 'ui.edu.skill.down_title')|trans }}
        </p>
        <p class="text-sm text-stone-600 mt-0.5">
          {{ (skillAssessment.isPromotion ? 'ui.edu.skill.up_text' : 'ui.edu.skill.down_text')|trans(skillParams) }}
        </p>
      </div>
      {% if canReplay %}
        <twig:Button
            label="{{ 'ui.edu.skill.cta'|trans(skillParams) }}"
            variant="{{ skillAssessment.isPromotion ? 'primary' : 'secondary' }}"
            size="sm"
            icon="fa-solid fa-play"
            href="{{ session.gameMode.isLiveComponent
              ? path('education_play_live', { mode: session.gameMode.value, difficulty: skillAssessment.suggested.value })
              : path('education_briefing', { mode: session.gameMode.value, difficulty: skillAssessment.suggested.value }) }}" />
      {% endif %}
    </div>
  {% endif %}

  <div class="mb-8">
    {% include 'partials/_ads_banner.html.twig' %}
  </div>

  {% if session.questions is not empty %}
    <div class="bg-white border border-stone-200 rounded-2xl shadow-sm p-6">
      <h2 class="text-lg font-semibold text-stone-800 mb-4">{{ 'ui.edu.question_details'|trans }}</h2>
      <div class="space-y-3">
        {% for question in session.questions %}
          {% set qData = question.questionData %}
          <div class="flex items-center gap-3 px-4 py-3 rounded-lg border border-stone-200
            {{ question.correct ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200' }}">
            <div class="shrink-0">
              {% if question.correct %}
                <i class="fa-solid fa-circle-check text-green-500" aria-hidden="true"></i>
              {% else %}
                <i class="fa-solid fa-circle-xmark text-red-500" aria-hidden="true"></i>
              {% endif %}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-stone-800 font-medium truncate">
                {{ qData.prompt ?? 'ui.edu.question'|trans({'%num%': question.questionIndex + 1}) }}
              </p>
              {% if qData.correctAnswer is defined %}
                <p class="text-xs text-stone-500 mt-0.5">
                  {{ 'ui.edu.your_answer'|trans }} <span class="{{ question.correct ? 'text-green-700' : 'text-red-700' }} font-medium">{{ question.answerGiven }}</span>
                  {% if not question.correct %}
                    — {{ 'ui.edu.correct_label'|trans }} : <span class="text-green-700 font-medium">{{ qData.correctAnswer }}</span>
                  {% endif %}
                </p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>
{% endblock %}
