{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.edu.result_title'|trans({'%mode%': result.mode.label|trans}) }}{% endblock %}

{% block body %}
{% set side = result.xp is not null or ads_enabled() %}
<div class="result-page">
    <div class="result-top{{ side ? '' : ' result-top-solo' }}">
        {{ include('education/result/_hero.html.twig') }}
        {% if side %}
            <div class="result-side">
                {% if result.xp is not null %}
                    <turbo-frame id="result-xp" class="result-xp-frame"{% if result.xp.pending %} x-data="resultXpSync"{% endif %}>
                        {{ include('education/result/_xp.html.twig', {xp: result.xp}) }}
                    </turbo-frame>
                {% endif %}
                {% if ads_enabled() %}
                    <div class="result-ad">
                        {% include 'partials/_ads_banner.html.twig' %}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% if result.missed is not empty %}
        {{ include('education/result/_missed.html.twig') }}
    {% endif %}

    {% if result.nextStep is not null %}
        {{ include('education/result/_next.html.twig', {next: result.nextStep}) }}
    {% endif %}

    {% if result.answers is not empty %}
        {{ include('education/result/_answers.html.twig') }}
    {% endif %}

    <nav class="result-more" aria-label="{{ 'ui.edu.result.nav_label'|trans }}">
        <a href="{{ path('education_index') }}" class="result-more-link result-more-modes">
            <i class="fa-solid fa-gamepad" aria-hidden="true"></i>{{ 'ui.edu.all_modes'|trans }}
        </a>
        <a href="{{ path('profile_user') }}" class="result-more-link">
            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>{{ 'ui.edu.dashboard'|trans }}
        </a>
    </nav>

    {{ include('education/result/_cta.html.twig') }}
</div>
{% endblock %}
