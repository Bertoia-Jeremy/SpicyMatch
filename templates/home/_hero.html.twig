<section class="home-hero-grid bg-cream overflow-hidden">

    <div class="hero-content">

        <div class="hero-meta">
            <span class="hero-meta-line" aria-hidden="true"></span>
            <span>{{ 'ui.home.hero.eyebrow'|trans }}</span>
        </div>

        <h1 class="home-h1 font-display font-medium">
            {{ 'ui.home.hero.title'|trans }}
            <em class="home-accent home-accent--paprika">{{ 'ui.home.hero.title_accent'|trans }}</em>
        </h1>

        <p class="home-hero-lead">{{ 'ui.home.hero.lead'|trans }}</p>
        <p class="home-hero-blurb">{{ 'ui.home.hero.blurb'|trans }}</p>

        <div class="hero-ctas">
            <a href="{{ path('index_spicy_match') }}" class="btn-hero-primary" data-home-cta="lab">
                {{ 'ui.home.hero.cta_lab'|trans }} <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href="{{ path('index_spices') }}" class="btn-hero-ghost">
                {{ 'ui.home.hero.cta_spices'|trans }}
            </a>
        </div>

        <ul class="home-reassure" aria-label="{{ 'ui.home.hero.reassure_label'|trans }}">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i>{{ 'ui.home.hero.reassure_free'|trans }}</li>
            {% if not is_granted('ROLE_USER') %}
                <li><i class="fa-solid fa-check" aria-hidden="true"></i>{{ 'ui.home.hero.reassure_no_account'|trans }}</li>
            {% endif %}
            <li><i class="fa-solid fa-check" aria-hidden="true"></i>{{ 'ui.home.hero.reassure_no_tracking'|trans }}</li>
        </ul>

        <p class="home-proof">
            {{ 'ui.home.hero.proof'|trans({'%spices%': spicesCount, '%compounds%': compoundsCount|format_number}) }}
        </p>

    </div>

    {% if demoSpices is not empty %}
        {% include 'home/_demo.html.twig' %}
    {% endif %}

</section>
