
<section id="jouer" class="home-section home-play" aria-labelledby="home-play-title">

    <div class="section-head">
        <div>
            <div class="section-label">{{ 'ui.home.play.label'|trans }}</div>
            <h2 id="home-play-title" class="home-h2 font-display font-medium">
                {{ 'ui.home.play.title'|trans }}
                <em class="home-accent home-accent--turmeric">{{ 'ui.home.play.title_accent'|trans }}</em>
            </h2>
        </div>
        <p class="section-blurb">
            {{ 'ui.home.play.text'|trans }}
        </p>
    </div>

    <div class="academie-teaser">
        <div class="embla" data-controller="carousel"
             role="group" aria-roledescription="{{ 'ui.carousel.roledescription'|trans }}"
             aria-label="{{ 'ui.carousel.label'|trans }}">
            <div class="embla__viewport" data-carousel-target="viewport">
                <div class="embla__container">
                    {% for mode in gameModes %}
                        <div class="embla__slide">
                            <a href="{{ path('education_index') }}" class="poster"
                               data-game-mode="{{ mode.value }}"
                               aria-label="{{ mode.label|trans }} — {{ mode.tagline|trans }}">
                                {% if mode == dailyFeaturedMode %}<span class="poster-ribbon">{{ 'ui.edu.daily_challenge'|trans }}</span>{% endif %}
                                <div class="poster-top">
                                    <div class="poster-num">{{ 'ui.edu.lesson'|trans({'%numeral%': ['I', 'II', 'III', 'IV', 'V', 'VI'][loop.index0]}) }}</div>
                                    {% if mode == dailyFeaturedMode and dailyBonusAvailable %}
                                        <span class="poster-bonus">{{ 'ui.edu.daily_bonus_pill'|trans }}</span>
                                    {% else %}
                                        <div class="poster-ornament" aria-hidden="true">✦</div>
                                    {% endif %}
                                </div>
                                <div class="poster-mid">
                                    <h3>{{ mode.titleTop|trans }}<span class="ital">{{ mode.titleBottom|trans }}</span></h3>
                                    <div class="poster-dash" aria-hidden="true"></div>
                                    <div class="poster-tag">{{ mode.tagline|trans }}</div>
                                </div>
                                <div class="poster-bot">
                                    <span>{{ mode.label|trans }}</span>
                                </div>
                                <span class="poster-play">{{ 'ui.edu.play'|trans }}</span>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button type="button" class="embla__button" data-carousel-target="prev" data-action="carousel#prev"
                        aria-label="{{ 'ui.carousel.prev'|trans }}">
                    <i class="fa-solid fa-chevron-left text-xs" aria-hidden="true"></i>
                </button>
                <button type="button" class="embla__button" data-carousel-target="next" data-action="carousel#next"
                        aria-label="{{ 'ui.carousel.next'|trans }}">
                    <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="theatre-cta">
        <p class="theatre-cta-sub">
            {{ 'ui.home.play.quota'|trans({'%count%': dailyGamesFree}) }}
        </p>
        <twig:Button
            label="{{ 'ui.home.play.cta'|trans }}"
            href="{{ path('education_index') }}"
            variant="primary"
            size="xl"
        />
    </div>

</section>
