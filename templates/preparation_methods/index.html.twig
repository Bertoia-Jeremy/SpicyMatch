{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.catalog.methods_page_title'|trans }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <twig:Catalog:Header
        tag="{{ 'ui.catalog.methods_tag'|trans }}"
        title="{{ 'ui.catalog.methods_title'|trans }}"
        intro="{{ 'ui.catalog.methods_intro'|trans }}"
    />

    <twig:Catalog:Grid>
        {% for method in preparationMethods %}
            <twig:Catalog:Card
                title="{{ method.getLocalizedName(loc) }}"
                description="{{ method.getLocalizedDescription(loc) }}"
                href="{{ path('view_preparation_methods', {slug: method.getLocalizedSlug(loc)}) }}"
                cta="{{ 'ui.catalog.view_details'|trans }}"
                icon="fa-solid fa-mortar-pestle"
                tone="paprika"
            />
            {% if loop.last and not loop.first %}
                {% include 'partials/_ads_grid_row.html.twig' %}
            {% endif %}
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-stone-400">{{ 'ui.catalog.no_method'|trans }}</p>
            </div>
        {% endfor %}
    </twig:Catalog:Grid>
</section>
{% endblock %}
