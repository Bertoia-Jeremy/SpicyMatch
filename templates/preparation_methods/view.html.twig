{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.meta.title.method'|trans({'%name%': preparationMethod.getLocalizedName(app.request.locale)}) }}{% endblock %}

{% block og_type %}article{% endblock %}

{% block meta_description %}{{ preparationMethod.getLocalizedDescription(app.request.locale)|seo_summary|default(preparationMethod.getLocalizedName(app.request.locale) ~ 'ui.catalog.define_lead'|trans({'%definition%': 'ui.catalog.define_method'|trans({'%count%': tips|length})})) }}{% endblock %}

{% block structured_data %}{{ include('partials/_json_ld.html.twig', {subject: preparationMethod}) }}{% endblock %}

{% block body %}
    {% set loc = app.request.locale %}
    {% set tools = preparationMethod.getLocalizedToolList(loc) %}
    {% set advice = preparationMethod.getLocalizedAdvice(loc) %}
    {% set why = preparationMethod.getLocalizedInformations(loc) %}
    {% set preview = 8 %}
    {% set section = 0 %}

    <article class="detail-page prep-page">
        <twig:Catalog:Crumbs :subject="preparationMethod" />

        <header class="prep-hero">
            <p class="detail-eyebrow">
                {{ 'ui.catalog.method_badge'|trans }}
                {% if tips is not empty %}· {{ 'ui.catalog.method_spice_count'|trans({'%count%': tips|length}) }}{% endif %}
            </p>
            <h1 class="detail-title">{{ preparationMethod.getLocalizedName(loc) }}</h1>
            <twig:Catalog:Lead :term="preparationMethod.getLocalizedName(loc)" :definition="'ui.catalog.define_method'|trans({'%count%': tips|length})" :text="preparationMethod.getLocalizedDescription(loc)" />
        </header>

        <div class="prep-layout">
            {% if tools is not empty %}
                {% set section = section + 1 %}
                <section class="prep-kit" aria-labelledby="prep-kit-title">
                    <header class="detail-section-head">
                        <span class="detail-section-num">{{ '%02d'|format(section) }} — {{ 'ui.catalog.method_kit'|trans }}</span>
                        <h2 id="prep-kit-title" class="detail-section-title">{{ 'ui.catalog.method_kit_title'|trans }}</h2>
                    </header>
                    <ul class="prep-tools">
                        {% for tool in tools %}
                            <li class="prep-tool">{{ tool }}</li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {% if tips is not empty %}
                {% set section = section + 1 %}
                <section class="prep-spices" aria-labelledby="prep-spices-title">
                    <header class="detail-section-head">
                        <span class="detail-section-num">{{ '%02d'|format(section) }} — {{ 'ui.catalog.method_spices'|trans }}</span>
                        <h2 id="prep-spices-title" class="detail-section-title">{{ 'ui.catalog.method_spices_title'|trans }}</h2>
                    </header>
                    <ul class="spice-rows">
                        {% for tip in tips|slice(0, preview) %}
                            <twig:Catalog:SpiceRow :spice="tip.spice" :loc="loc" :meta="tip.getLocalizedTitle(loc)" :note="tip.getLocalizedAdvantages(loc)" />
                        {% endfor %}
                    </ul>
                    {% if tips|length > preview %}
                        <details class="spice-rows-more">
                            <summary>
                                <span class="spice-rows-more-open">{{ 'ui.catalog.show_more_spices'|trans({'%count%': tips|length - preview}) }}</span>
                                <span class="spice-rows-more-close">{{ 'ui.catalog.show_less_spices'|trans }}</span>
                                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                            </summary>
                            <ul class="spice-rows">
                                {% for tip in tips|slice(preview) %}
                                    <twig:Catalog:SpiceRow :spice="tip.spice" :loc="loc" :meta="tip.getLocalizedTitle(loc)" :note="tip.getLocalizedAdvantages(loc)" />
                                {% endfor %}
                            </ul>
                        </details>
                    {% endif %}
                </section>
            {% endif %}

            <div class="prep-aside">
                {% if advice %}
                    <section class="prep-advice" aria-labelledby="prep-advice-title">
                        <h2 id="prep-advice-title" class="prep-label">
                            <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>{{ 'ui.catalog.method_advice'|trans }}
                        </h2>
                        <blockquote><p>{{ advice }}</p></blockquote>
                    </section>
                {% endif %}

                {% if why %}
                    <section class="prep-why" aria-labelledby="prep-why-title">
                        <h2 id="prep-why-title" class="prep-label">
                            <i class="fa-solid fa-flask" aria-hidden="true"></i>{{ 'ui.catalog.method_why'|trans }}
                        </h2>
                        <p>{{ why }}</p>
                    </section>
                {% endif %}
            </div>
        </div>
    </article>
{% endblock %}
