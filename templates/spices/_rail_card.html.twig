{% set relGroup = related.aromaticGroups %}
{% set relTint = relGroup and relGroup.color matches '/^#[0-9a-fA-F]{3,8}$/' ? relGroup.color : null %}
{% set relImg = vich_uploader_asset(related, 'imageFile') %}
{% set relTag = headingTag|default('h3') %}
<a href="{{ path('view_spice', {slug: related.getLocalizedSlug(loc)}) }}" class="fil-card group"{% if relTint %} style="--card-tint: {{ relTint }}"{% endif %}>
    <div class="fc-img">
        <span class="fc-tag">
            <span class="fc-dot" aria-hidden="true"></span>
            {{ relGroup ? relGroup.getLocalizedName(loc) : 'ui.catalog.spice_fallback'|trans }}
        </span>
        {% if relImg %}
            <img src="{{ relImg|imagine_filter('spice_card') }}"
                 srcset="{{ relImg|imagine_filter('spice_card') }} 1x, {{ relImg|imagine_filter('spice_card_2x') }} 2x"
                 alt=""
                 loading="lazy" decoding="async" width="400" height="400">
        {% else %}
            <span class="fc-fallback"><i class="fa-solid fa-seedling" aria-hidden="true"></i></span>
        {% endif %}
    </div>
    <{{ relTag }} class="fc-name">{{ related.getLocalizedName(loc) }}</{{ relTag }}>
    {% if related.spicyType %}
        <p class="fc-type">{{ related.spicyType.getLocalizedName(loc) }}</p>
    {% endif %}
</a>
