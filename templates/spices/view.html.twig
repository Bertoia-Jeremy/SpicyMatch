{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.meta.title.spice'|trans({'%name%': spice.getLocalizedName(app.request.locale)}) }}{% endblock %}

{% block og_type %}article{% endblock %}

{% block metas %}
    {% set _heroImg = vich_uploader_asset(spice, 'imageFile') %}
    {% if _heroImg %}
        <link rel="preload" as="image" type="image/webp" href="{{ _heroImg|imagine_filter('spice_hero') }}"
              imagesrcset="{{ _heroImg|imagine_filter('spice_card') }} 400w, {{ _heroImg|imagine_filter('spice_hero') }} 800w"
              imagesizes="(min-width: 64rem) 20rem, (min-width: 48rem) 15rem, (min-width: 30rem) 10.5rem, 9rem" fetchpriority="high">
    {% endif %}
{% endblock %}

{% block meta_description %}{{ spice.getLocalizedDescription(app.request.locale)|seo_summary|default(spice.getLocalizedName(app.request.locale) ~ 'ui.catalog.define_lead'|trans({'%definition%': 'ui.catalog.define_spice'|trans})) }}{% endblock %}

{% block structured_data %}{{ include('partials/_json_ld.html.twig', {subject: spice}) }}{% endblock %}

{% block og_image %}
    {% set _ogImg = vich_uploader_asset(spice, 'imageFile') %}
    {% if _ogImg %}
        <meta property="og:image" content="{{ _ogImg|imagine_filter('spice_hero') }}">
        <meta property="og:image:type" content="image/webp">
        <meta property="og:image:width" content="800">
        <meta property="og:image:height" content="800">
        <meta property="og:image:alt" content="{{ spice.getLocalizedName(app.request.locale) }}">
    {% endif %}
{% endblock %}

{% block body %}
    {% set loc = app.request.locale %}
    {% set name = spice.getLocalizedName(loc) %}
    {% set group = spice.aromaticGroups %}
    {% set type = spice.spicyType %}
    {% set tint = group and group.color matches '/^#[0-9a-fA-F]{3,8}$/' ? group.color : null %}
    {% set heroImg = vich_uploader_asset(spice, 'imageFile') %}
    {% set description = spice.getLocalizedDescription(loc) %}
    {% set definition = type ? 'ui.catalog.define_spice_type'|trans({'%type%': type.getLocalizedName(loc)}) : 'ui.catalog.define_spice'|trans %}
    {% set definition = group ? 'ui.catalog.define_spice_group'|trans({'%base%': definition, '%group%': group.getLocalizedName(loc)}) : definition %}
    {% set cooking = spice.getLocalizedCooking(loc) %}
    {% set informations = spice.getLocalizedInformations(loc) %}
    {% set benefits = spice.getLocalizedBenefits(loc) %}
    {% set primaries = spice.aromaticsCompounds %}
    {% set secondaries = spice.secondaryAromaticsCompounds %}
    {% set moments = spice.cookingTips|sort((a, b) => a.moment.value <=> b.moment.value) %}
    {% set preps = spice.preparationTips %}
    {% set hasProfile = primaries is not empty or secondaries is not empty %}
    {% set hasKitchen = moments is not empty %}
    {% set hasNotebook = cooking or informations or benefits or preps is not empty %}
    {% set hasPairs = compatibleSpices is not empty %}
    {% set swatches = ['spc-swatch-1', 'spc-swatch-2', 'spc-swatch-3', 'spc-swatch-4', 'spc-swatch-5'] %}
    {% set flavors = {} %}
    {% for compound in primaries.toArray|merge(secondaries.toArray) %}
        {% for flavor in compound.alchemyFlavors %}
            {% set flavors = flavors|merge({('f' ~ flavor.id): flavor}) %}
        {% endfor %}
    {% endfor %}
    {% set section = 0 %}
    {{ include('partials/_content_read.html.twig', {kind: 'spice', id: spice.id}) }}

    <article class="detail-page spc-page"{% if tint %} style="--spc-tint: {{ tint }}"{% endif %}>
        <twig:Catalog:Crumbs
            :items="[{label: 'ui.catalog.breadcrumb_spices'|trans, href: path('index_spices')}]|merge(group ? [{label: group.getLocalizedName(loc), href: path('view_aromatic_groups', {slug: group.getLocalizedSlug(loc)})}] : [])"
            current="{{ name }}"
        />

        <header class="spc-hero{{ heroImg ? ' spc-hero-has-media' }}">
            <div class="spc-hero-text">
                {% if group or type %}
                    <dl class="spc-facets">
                        {% if group %}
                            <div>
                                <dt class="sr-only">{{ 'ui.catalog.group_badge'|trans }}</dt>
                                <dd><a class="spc-facet" href="{{ path('view_aromatic_groups', {slug: group.getLocalizedSlug(loc)}) }}">
                                    <span class="spc-facet-dot" aria-hidden="true"></span>{{ group.getLocalizedName(loc) }}
                                </a></dd>
                            </div>
                        {% endif %}
                        {% if type %}
                            <div>
                                <dt class="sr-only">{{ 'ui.catalog.type_badge'|trans }}</dt>
                                <dd><a class="spc-facet" href="{{ path('view_spicy_type', {slug: type.getLocalizedSlug(loc)}) }}">
                                    <i class="fa-solid fa-tag" aria-hidden="true"></i>{{ type.getLocalizedName(loc) }}
                                </a></dd>
                            </div>
                        {% endif %}
                    </dl>
                {% endif %}
                <h1 class="detail-title{{ name|length > 24 ? ' detail-title-long' }}">{{ name }}</h1>
                <twig:Catalog:Lead :term="name" :definition="definition" :text="description" />
            </div>
            {% if heroImg %}
                <div class="spc-hero-media">
                    <img src="{{ heroImg|imagine_filter('spice_hero') }}" alt="{{ name }}"
                         srcset="{{ heroImg|imagine_filter('spice_card') }} 400w, {{ heroImg|imagine_filter('spice_hero') }} 800w"
                         sizes="(min-width: 64rem) 20rem, (min-width: 48rem) 15rem, (min-width: 30rem) 10.5rem, 9rem"
                         fetchpriority="high" loading="eager" decoding="async" width="800" height="800">
                </div>
            {% endif %}
        </header>

        {% if hasProfile or hasKitchen or hasNotebook or hasPairs %}
            <nav class="spc-anchors" aria-label="{{ 'ui.catalog.spice_anchors_label'|trans }}">
                <ul>
                    {% if hasProfile %}<li><a class="spc-anchor" href="#spc-profile">{{ 'ui.catalog.profile'|trans }}</a></li>{% endif %}
                    {% if hasKitchen %}<li><a class="spc-anchor" href="#spc-kitchen">{{ 'ui.catalog.in_kitchen'|trans }}</a></li>{% endif %}
                    {% if hasNotebook %}<li><a class="spc-anchor" href="#spc-notebook">{{ 'ui.catalog.notebook'|trans }}</a></li>{% endif %}
                    {% if hasPairs %}<li><a class="spc-anchor" href="#spc-pairs">{{ 'ui.catalog.pairs_with'|trans }}</a></li>{% endif %}
                </ul>
            </nav>
        {% endif %}

        {% if hasProfile %}
            {% set section = section + 1 %}
            <section id="spc-profile" class="spc-section spc-profile" aria-labelledby="spc-profile-title">
                <header class="detail-section-head">
                    <span class="detail-section-num">{{ '%02d'|format(section) }} — {{ 'ui.catalog.profile'|trans }}</span>
                    <h2 id="spc-profile-title" class="detail-section-title">{{ 'ui.catalog.flavors_heading_html'|trans|raw }}</h2>
                    <p class="spc-section-hint">{{ 'ui.catalog.flavors_intro'|trans }}</p>
                </header>

                <div class="spc-profile-grid">
                    {% if primaries is not empty %}
                        <div class="spc-bowl" aria-hidden="true">
                            {% for compound in primaries|slice(0, 5) %}
                                <span class="spc-pile spc-pile-{{ loop.index }} {{ swatches[loop.index0] }}">{{ loop.index }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="spc-profile-body">
                        {% if primaries is not empty %}
                            <h3 class="spc-subtitle">{{ 'ui.catalog.primary_compounds_heading_html'|trans|raw }}</h3>
                            <ol class="spc-compounds">
                                {% for compound in primaries %}
                                    <li>
                                        <a class="spc-compound" href="{{ path('view_aromatic_compound', {slug: compound.getLocalizedSlug(loc)}) }}">
                                            <span class="spc-swatch {{ swatches[loop.index0] ?? 'spc-swatch-0' }}" aria-hidden="true">{{ loop.index }}</span>
                                            <span class="spc-compound-body">
                                                <span class="spc-compound-name">{{ compound.getLocalizedName(loc) }}</span>
                                                {% if compound.alchemyFlavors is not empty %}
                                                    <span class="spc-compound-notes">{{ compound.alchemyFlavors|map(f => f.getLocalizedName(loc))|join(' · ') }}</span>
                                                {% endif %}
                                            </span>
                                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}

                        {% if secondaries is not empty %}
                            <div class="spc-background">
                                <h3 class="spc-label">
                                    <i class="fa-solid fa-flask-vial" aria-hidden="true"></i>{{ 'ui.catalog.secondary_compounds'|trans }}
                                </h3>
                                <p class="spc-background-hint">{{ 'ui.catalog.spice_background_hint'|trans }}</p>
                                <ul class="ref-chips">
                                    {% for compound in secondaries %}
                                        <li><a class="ref-chip ref-chip-molecule" href="{{ path('view_aromatic_compound', {slug: compound.getLocalizedSlug(loc)}) }}">{{ compound.getLocalizedName(loc) }}</a></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if flavors is not empty %}
                            <div class="spc-flavors">
                                <h3 class="spc-label">{{ 'ui.catalog.compound_perceived'|trans }}</h3>
                                <ul class="ref-chips">
                                    {% for flavor in flavors %}
                                        <li><a class="ref-chip ref-chip-flavor" href="{{ path('view_alchemy_flavors', {slug: flavor.getLocalizedSlug(loc)}) }}">{{ flavor.getLocalizedName(loc) }}</a></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </section>
        {% endif %}

        {% set ad = include('partials/_ads_banner.html.twig') %}
        {% if ad|trim %}
            <div class="spc-ad">{{ ad }}</div>
        {% endif %}

        {% if hasKitchen %}
            {% set section = section + 1 %}
            <section id="spc-kitchen" class="spc-section spc-kitchen" aria-labelledby="spc-kitchen-title">
                <header class="detail-section-head">
                    <span class="detail-section-num">{{ '%02d'|format(section) }} — {{ 'ui.catalog.in_kitchen'|trans }} · {{ 'ui.catalog.moments'|trans({'%count%': moments|length}) }}</span>
                    <h2 id="spc-kitchen-title" class="detail-section-title">{{ 'ui.catalog.in_kitchen_heading_html'|trans|raw }}</h2>
                </header>

                <ol class="spc-moments">
                    {% for tip in moments %}
                        {% set advantages = tip.getLocalizedAdvantages(loc) %}
                        {% set tipDuos = duosByCook[tip.id] ?? [] %}
                        <li class="spc-moment">
                            <span class="spc-moment-glyph" aria-hidden="true"><i class="fa-solid {{ tip.moment.icon }}"></i></span>
                            <div class="spc-moment-body">
                                <p class="spc-moment-when">{{ tip.moment.label|trans }}</p>
                                <h3 class="spc-moment-title">{{ tip.getLocalizedTitle(loc) ?? tip.moment.label|trans }}</h3>
                                <p class="spc-moment-text">{{ tip.getLocalizedText(loc) }}</p>
                                {% if advantages %}
                                    <p class="spc-advantage"><i class="fa-solid fa-check" aria-hidden="true"></i><span>{{ advantages }}</span></p>
                                {% endif %}
                                {% if tipDuos is not empty %}
                                    <ul class="spc-duos" aria-label="{{ 'ui.catalog.chef_duo'|trans }}">
                                        {% for duo in tipDuos %}
                                            <li class="spc-duo">
                                                {% if duo.method %}<span class="spc-duo-method">{{ duo.method }}</span>{% endif %}
                                                <span class="spc-duo-title">{{ duo.title }}</span>
                                                <span class="spc-duo-effect">{{ duo.effect }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            </section>
        {% endif %}

        {% if hasNotebook %}
            {% set section = section + 1 %}
            <section id="spc-notebook" class="spc-section spc-notebook" aria-labelledby="spc-notebook-title">
                <header class="detail-section-head">
                    <span class="detail-section-num">{{ '%02d'|format(section) }} — {{ 'ui.catalog.notebook'|trans }}</span>
                    <h2 id="spc-notebook-title" class="detail-section-title">{{ 'ui.catalog.notebook_heading_html'|trans|raw }}</h2>
                </header>

                <div class="spc-notebook-grid">
                    {% if cooking or informations or benefits %}
                        <div class="spc-notes">
                            {% if cooking %}
                                <h3 class="spc-subtitle">{{ 'ui.catalog.tame_heading_html'|trans|raw }}</h3>
                                <p class="spc-prose">{{ cooking }}</p>
                            {% endif %}
                            {% if informations %}
                                <aside class="spc-callout">
                                    <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="spc-callout-title">{{ 'ui.catalog.good_to_know'|trans }}</h3>
                                        <p>{{ informations }}</p>
                                    </div>
                                </aside>
                            {% endif %}
                            {% if benefits %}
                                <aside class="spc-callout spc-callout-tips">
                                    <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="spc-callout-title">{{ 'ui.catalog.spice_good_to_know'|trans }}</h3>
                                        <p>{{ benefits }}</p>
                                    </div>
                                </aside>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if preps is not empty %}
                        <div class="spc-preps">
                            <h3 class="spc-label"><i class="fa-solid fa-mortar-pestle" aria-hidden="true"></i>{{ 'ui.catalog.spice_prep_title'|trans }}</h3>
                            <ul class="spc-prep-list">
                                {% for prep in preps %}
                                    {% set advantages = prep.getLocalizedAdvantages(loc) %}
                                    {% set method = prep.preparationMethod %}
                                    <li class="spc-prep">
                                        <h4 class="spc-prep-title">{{ prep.getLocalizedTitle(loc) }}</h4>
                                        <p class="spc-prep-text">{{ prep.getLocalizedText(loc)|nl2br }}</p>
                                        {% if advantages %}
                                            <p class="spc-advantage"><i class="fa-solid fa-check" aria-hidden="true"></i><span>{{ advantages }}</span></p>
                                        {% endif %}
                                        {% if method %}
                                            <a class="spc-prep-method" href="{{ path('view_preparation_methods', {slug: method.getLocalizedSlug(loc)}) }}">
                                                {{ 'ui.catalog.spice_prep_method'|trans({'%name%': method.getLocalizedName(loc)}) }}
                                                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                            </a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </section>
        {% endif %}

        {% if hasPairs %}
            {% set section = section + 1 %}
            <section id="spc-pairs" class="spc-section spc-pairs" data-rail="compatible" aria-labelledby="spc-pairs-title">
                <header class="detail-section-head">
                    <span class="detail-section-num">{{ '%02d'|format(section) }} — {{ 'ui.catalog.pairs_with'|trans }}</span>
                    <h2 id="spc-pairs-title" class="detail-section-title">{{ 'ui.catalog.spice_pairs_title'|trans }}</h2>
                    <p class="spc-section-hint">{{ 'ui.catalog.pairs_with_text'|trans({'%name%': name}) }}</p>
                </header>
                <ul class="spice-rail">
                    {% for related in compatibleSpices %}
                        <li>{{ include('spices/_rail_card.html.twig', {related: related, loc: loc}) }}</li>
                    {% endfor %}
                </ul>
                <a class="btn-pill-base btn-pill-primary spc-cta" href="{{ path('index_spicy_match', {spice: spice.getLocalizedSlug(loc)}) }}">
                    <i class="fa-solid fa-flask" aria-hidden="true"></i>
                    <span>{{ 'ui.catalog.compose_with'|trans({'%name%': name}) }}</span>
                </a>
            </section>
        {% endif %}

        {% if relatedSpices is not empty %}
            {% set section = section + 1 %}
            <section class="spc-section spc-thread" aria-labelledby="spc-thread-title">
                <header class="detail-section-head">
                    <span class="detail-section-num">{{ '%02d'|format(section) }} — {{ 'ui.catalog.spice_thread'|trans }}</span>
                    <h2 id="spc-thread-title" class="detail-section-title">{{ 'ui.catalog.spice_thread_title'|trans }}</h2>
                    <p class="spc-section-hint">{{ 'ui.catalog.spice_thread_text'|trans }}</p>
                </header>
                <ul class="spice-rail">
                    {% for related in relatedSpices %}
                        <li>{{ include('spices/_rail_card.html.twig', {related: related, loc: loc}) }}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </article>
{% endblock %}
