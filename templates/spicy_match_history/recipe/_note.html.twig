{% set shared = recipe.sharedCompounds %}
<section class="recipe-note">
    <button type="button" class="recipe-note-head" x-on:click="noteOpen = !noteOpen" x-bind:aria-expanded="noteOpen" aria-expanded="false" aria-controls="recipe-note-body">
        <span class="recipe-mono">{{ 'ui.recipe.alchemist_note'|trans }}</span>
        <span class="recipe-mono text-saffron-800" x-show="!noteOpen">{{ 'ui.recipe.read'|trans }}</span>
        <span class="recipe-mono text-saffron-800" x-show="noteOpen" x-cloak>{{ 'ui.recipe.collapse'|trans }}</span>
    </button>
    <div id="recipe-note-body">
        <p class="recipe-note-quote" x-bind:class="!noteOpen && 'line-clamp-2'">
            {% if shared is not empty %}
                {{ 'ui.recipe.note_shared'|trans({'%count%': shared|length}) }}
            {% elseif history.spicyMatch.isManual %}
                {{ 'ui.recipe.note_manual'|trans }}
            {% else %}
                {{ 'ui.recipe.note_contrast'|trans }}
            {% endif %}
        </p>
        {% if shared is not empty %}
            <ul class="mt-2 flex flex-wrap gap-x-2 gap-y-1" x-show="noteOpen" x-cloak>
                {% for compound in shared %}
                    <li>
                        <a href="{{ path('view_aromatic_compound', {slug: compound.getLocalizedSlug(loc)}) }}" class="recipe-mono text-saffron-800 hover:underline">{{ compound.getLocalizedName(loc) }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>
