{% extends 'base.html.twig' %}

{% set loc = app.request.locale %}
{% set placeholder = 'ui.recipe.untitled_placeholder'|trans %}

{% block title %}{{ 'ui.common.recipe_label'|trans }} — {{ history.title ?? placeholder }}{% endblock %}

{% block body %}
<div x-data="recetteView"
     class="recipe-page etamine-paper"
     data-id="{{ history.id }}"
     data-rename-url="{{ path('rename_spicy_match_history', {id: history.id}) }}"
     data-favorite-url="{{ path('set_favorite_spicy_match_history', {id: history.id}) }}"
     data-token="{{ csrf_token('history_action_' ~ history.id) }}"
     data-title="{{ history.title }}"
     data-placeholder="{{ placeholder }}"
     data-favorite="{{ history.isFavorite ? '1' : '0' }}"
     data-guest="{{ is_granted('ROLE_USER') ? '0' : '1' }}"
     data-cook-steps="{{ 1 + recipe.usedMoments|length }}">

    <div class="recipe-shell" x-bind:inert="cook.active">
        {{ include('spicy_match_history/recipe/_header.html.twig') }}

        <div class="recipe-segment-wrap">
            <div class="recipe-segment" role="tablist" aria-label="{{ 'ui.recipe.tabs_aria'|trans }}">
                <button type="button" role="tab" id="recipe-tab-timeline" aria-controls="recipe-panel-timeline"
                        class="recipe-segment-btn is-active"
                        x-on:click="tab = 'timeline'"
                        x-bind:class="tab === 'timeline' && 'is-active'"
                        x-bind:aria-selected="tab === 'timeline'"
                        aria-selected="true">{{ 'ui.recipe.tab_timeline'|trans }}</button>
                <button type="button" role="tab" id="recipe-tab-spices" aria-controls="recipe-panel-spices"
                        class="recipe-segment-btn"
                        x-on:click="tab = 'spices'"
                        x-bind:class="tab === 'spices' && 'is-active'"
                        x-bind:aria-selected="tab === 'spices'"
                        aria-selected="false">{{ 'ui.recipe.tab_spices'|trans }}</button>
            </div>
        </div>

        <div id="recipe-panel-timeline" role="tabpanel" aria-labelledby="recipe-tab-timeline" x-show="tab === 'timeline'">
            {{ include('spicy_match_history/recipe/_timeline.html.twig') }}
        </div>

        <div id="recipe-panel-spices" role="tabpanel" aria-labelledby="recipe-tab-spices" x-show="tab === 'spices'" x-cloak>
            {{ include('spicy_match_history/recipe/_spice_cards.html.twig') }}
            {% if oav_context_enabled %}
                {{ include('spicy_match_history/recipe/_oav_insights.html.twig') }}
            {% endif %}
        </div>

        <p class="mt-8 text-center">
            <a href="{{ path('index_spicy_match') }}" class="recipe-link">{{ 'ui.recipe.new_blend'|trans }}</a>
        </p>

        {% if recipe.steps is not empty %}
            <div class="recipe-cta">
                <button type="button" class="recipe-cta-btn" x-ref="cookCta" x-on:click="enterCook()">
                    <i class="fa-solid fa-play" aria-hidden="true"></i>
                    <span>{{ 'ui.recipe.cook_mode.start'|trans }}</span>
                </button>
            </div>
        {% endif %}
    </div>

    <div class="recipe-toast" role="status" x-show="favError" x-cloak>
        <span>{{ 'ui.recipe.favorite_failed'|trans }}</span>
        <button type="button" class="recipe-toast-btn" x-on:click="retryFavorite()">{{ 'ui.recipe.retry'|trans }}</button>
    </div>

    <template x-if="cook.active">
        {{ include('spicy_match_history/recipe/_cook_mode.html.twig') }}
    </template>
</div>
{% endblock %}
