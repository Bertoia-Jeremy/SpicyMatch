{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.catalog.types_page_title'|trans }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <twig:Catalog:Header
        tag="{{ 'ui.catalog.types_tag'|trans }}"
        title="{{ 'ui.catalog.types_title'|trans }}"
        intro="{{ 'ui.catalog.types_intro'|trans }}"
    />

    <twig:Catalog:Grid>
        {% for type in spicyTypes %}
            <twig:Catalog:Card
                title="{{ type.getLocalizedName(loc) }}"
                description="{{ type.getLocalizedDescription(loc) }}"
                href="{{ path('view_spicy_type', {slug: type.getLocalizedSlug(loc)}) }}"
                cta="{{ 'ui.catalog.view_spices'|trans }}"
                icon="fa-solid fa-tags"
                tone="saffron"
            />
            {% if loop.last and not loop.first %}
                {% include 'partials/_ads_grid_row.html.twig' %}
            {% endif %}
        {% else %}
            <div class="col-span-full text-center py-12">
                <p class="text-stone-400">{{ 'ui.catalog.no_type'|trans }}</p>
            </div>
        {% endfor %}
    </twig:Catalog:Grid>
</section>
{% endblock %}
