{% extends 'base.html.twig' %}

{% block title %}{{ spicyType.getLocalizedName(app.request.locale) }} — SpicyMatch{% endblock %}

{% block meta_description %}{{ spicyType.getLocalizedDescription(app.request.locale)|seo_summary|default('ui.meta.description'|trans) }}{% endblock %}

{% block structured_data %}{{ include('partials/_json_ld.html.twig', {subject: spicyType}) }}{% endblock %}

{% block body %}
{% set loc = app.request.locale %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <twig:Catalog:Hero
        backLabel="{{ 'ui.catalog.back_to_types'|trans }}"
        backHref="{{ path('index_spicy_type') }}"
        badge="{{ 'ui.catalog.type_badge'|trans }}"
        icon="fa-solid fa-tags"
        title="{{ spicyType.getLocalizedName(loc) }}"
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mb-16">
        <div class="lg:col-span-2 space-y-8">
            <twig:Catalog:Section title="{{ 'ui.catalog.definition'|trans }}" icon="fa-solid fa-circle-info">
                {{ spicyType.getLocalizedDescription(loc)|default('ui.catalog.no_definition_detailed'|trans)|nl2br }}
            </twig:Catalog:Section>

            {% if spicyType.getLocalizedCooking(loc) %}
                <twig:Catalog:Section title="{{ 'ui.catalog.general_usage'|trans }}" icon="fa-solid fa-mortar-pestle">
                    {{ spicyType.getLocalizedCooking(loc)|nl2br }}
                </twig:Catalog:Section>
            {% endif %}
        </div>

        <aside class="space-y-8">
            {% if spicyType.getLocalizedInformations(loc) %}
                <twig:Catalog:Section title="{{ 'ui.catalog.botanical_note'|trans }}" icon="fa-solid fa-flask" small>
                    {{ spicyType.getLocalizedInformations(loc)|nl2br }}
                </twig:Catalog:Section>
            {% endif %}
        </aside>
    </div>

    <twig:Catalog:LinkedSpices :spices="spicyType.spices" title="{{ 'ui.catalog.spices_of_type'|trans }}" />
</div>
{% endblock %}
